# Database
MALL_WORKER_ENABLED=false
MALL_REFUND_SIMULATION_ENABLED=false
APP_ENVIRONMENT=development
SCHEMA_AUTO_CREATE_ENABLED=false
MALL_ENABLED=false
MALL_PURCHASE_ENABLED=false
MALL_GATEWAY_MODE=test
MALL_GATEWAY_OUTBOUND_ENABLED=false
MALL_GATEWAY_CALLBACK_ENABLED=false
MALL_STORAGE_OUTBOUND_ENABLED=false
# Internal single-record data views require explicit review inputs and remain off by default.
MALL_DATA_RELEASE_ENABLED=false
MALL_DATA_RELEASE_RETENTION_POLICY_REF=
MALL_DATA_RELEASE_NOTICE_APPROVED_VERSION=
# Payment identity/APIv2 key material: fill from the WeChat merchant platform; keep live switches closed.
MALL_WECHAT_MCHID=1003357017
MALL_WECHAT_API_V2_KEY=1234567890abcdefghijklmnopqrstAB
MALL_WECHAT_API_V2_SIGN_TYPE=MD5
MALL_WECHAT_SPBILL_CREATE_IP=49.233.155.116
MALL_WECHAT_REFUND_CLIENT_CERT_PATH=/etc/wechat-pay/apiclient_cert.pem
MALL_WECHAT_REFUND_CLIENT_KEY_PATH=/etc/wechat-pay/apiclient_key.pem
MALL_WECHAT_NOTIFY_URL=https://bjrutai.com/api/v1/mall-gateway/wechat/payment-notify
MALL_WECHAT_REFUND_NOTIFY_URL=https://bjrutai.com/api/v1/mall-gateway/wechat/refund-notify
# Independent application encryption keyring for persisted prepay IDs.
MALL_PREPAY_KEYS={}
MALL_PREPAY_ACTIVE_KEY=k1
# Logistics uses synthetic events outside production; real data release remains gated.
# live mode works only in development/test with both flags on and complete
# province/city/district names in the warehouse and buyer address. Production
# stays closed regardless. Only administrative region names are sent to Kuaidi100.
MALL_KUAIDI100_MODE=fake
MALL_KUAIDI100_OUTBOUND_ENABLED=false
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
# Own ICP-filed HTTPS origin serving the mall-map.html wrapper page (the page
# embeds the Kuaidi100 map in an iframe; no server-side proxy needed). Required
# in production before the mini-program web-view map entry is exposed.
KUAIDI100_MAP_PUBLIC_BASE=
DATABASE_URL=mysql+aiomysql://user:psw@dblink@db/bjrutai?charset=utf8mb4

# WeChat Mini-Program
WECHAT_APP_ID=wxXXXXXXXXXXXXXX
WECHAT_APP_SECRET=your_app_secret_here
PUBLIC_API_BASE_URL=https://bjrutai.com/api/v1

# JWT
JWT_SECRET_KEY=generate-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# Harbin Rutai API
RUTAI_API_BASE_URL=https://api.rutai.example.com
RUTAI_API_KEY=your_api_key
RUTAI_API_SECRET=your_api_secret

# Tencent Cloud COS
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=bjrutai-uploads
COS_REGION=ap-beijing

# Tencent Cloud VOD
VOD_SECRET_ID=
VOD_SECRET_KEY=
VOD_SUB_APP_ID=
VOD_REGION=ap-beijing
VOD_PROCEDURE=
VOD_CALLBACK_SIGN_KEY=
VOD_PLAYBACK_HOSTS=
VOD_CLEANUP_ENABLED=false

# Admin
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me-immediately
RUTAI_MOCK=true
