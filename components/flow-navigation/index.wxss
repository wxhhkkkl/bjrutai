@import "../../styles/interactions.wxss";

.flow-navigation {
  position: relative;
  z-index: 20;
  width: 100%;
  background: rgba(255, 255, 255, 0.98);
}

.flow-navigation__row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flow-navigation__back {
  position: absolute;
  left: 40rpx;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 1rpx solid #edf0f4;
  border-radius: 50%;
  box-shadow: 0 8rpx 18rpx rgba(24, 48, 82, 0.11);
}

.flow-navigation__title {
  max-width: 430rpx;
  overflow: hidden;
  color: #050505;
  font-size: 39rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  text-overflow: ellipsis;
}
