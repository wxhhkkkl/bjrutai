<view wx:if="{{state !== 'success'}}" class="state-box"><text class="state-symbol">{{state === 'loading' ? '···' : state === 'empty' ? '○' : state === 'forbidden' ? '!' : '×'}}</text><text class="state-title">{{state === 'loading' ? '正在加载' : state === 'empty' ? '暂无内容' : state === 'forbidden' ? '暂不可访问' : '加载遇到问题'}}</text><text class="state-message">{{message}}</text><button wx:if="{{state === 'recoverable-error'}}" class="state-action tap-target" bindtap="retry" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">重新加载</button><button wx:if="{{state === 'forbidden'}}" class="state-action tap-target" bindtap="goBack" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">返回</button></view>
