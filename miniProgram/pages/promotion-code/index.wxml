<flow-navigation title="客户绑定码" bind:back="handleBack" />

<view class="promotion-page">
    <view class="promotion-profile">
        <view class="promotion-profile__avatar" aria-role="img" aria-label="推广人头像">
            <van-icon name="contact-o" size="39px" color="#1677ff" />
            <view class="promotion-profile__link">
                <van-icon name="link-o" size="16px" color="#1677ff" />
            </view>
        </view>
        <view class="promotion-profile__copy">
            <text class="promotion-profile__name">{{profile.name}}</text>
            <text class="promotion-profile__role">{{profile.roleLabel}}</text>
        </view>
        <view class="promotion-profile__status">
            <van-icon name="passed" size="16px" color="#18a63d" />
            <text>{{profile.statusLabel}}</text>
        </view>
    </view>

    <view class="promotion-card">
        <text class="promotion-card__title">专属客户绑定码</text>
        <image wx:if="{{profile.qrImage && qrState !== 'error'}}" class="promotion-card__qr" src="{{profile.qrImage}}" mode="aspectFit"
            show-menu-by-longpress aria-role="img" aria-label="专属推广二维码" bindload="handleQrLoad" binderror="handleQrError" />
        <view wx:elif="{{qrState === 'error'}}" class="promotion-card__empty promotion-card__qr-error">
            <van-icon name="warning-o" size="40px" color="#d98b27" />
            <text>客户绑定码图片加载失败</text>
            <button class="promotion-qr-retry tap-target" bindtap="refreshPromotionCode" loading="{{saving}}" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">重新生成</button>
        </view>
        <view wx:else class="promotion-card__empty">
            <van-icon name="photo-o" size="40px" color="#8b95a6" />
            <text>客户绑定码暂未生成，请稍后重试</text>
        </view>
        <text class="promotion-card__hint">患者扫码并授权手机号后，将直接归属于您</text>
        <text class="promotion-card__source">来源将标记为{{profile.sourceCity}}</text>
    </view>

    <view class="promotion-actions">
        <button class="promotion-action promotion-action--save tap-target" bindtap="savePromotionCode"
            hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80" loading="{{saving}}"
            disabled="{{saving}}">
            <van-icon wx:if="{{!saving}}" name="down" size="23px" color="#ffffff" />
            <text>{{saving ? '保存中' : '保存图片'}}</text>
        </button>
        <button class="promotion-action promotion-action--share tap-target" open-type="share" hover-class="tap-feedback"
            hover-start-time="0" hover-stay-time="80">
            <van-icon name="share-o" size="23px" color="#111318" />
            <text>分享推广码</text>
        </button>
    </view>
    <view class="promotion-refresh tap-target" bindtap="refreshPromotionCode" hover-class="tap-feedback"
        hover-start-time="0" hover-stay-time="80">绑定码失效或泄露？点击刷新</view>

    <text class="promotion-section-title">使用说明</text>
    <view class="promotion-steps">
        <view wx:for="{{steps}}" wx:key="id" class="promotion-step">
            <view class="promotion-step__icon">
                <van-icon name="{{item.icon}}" size="31px" color="#1677ff" />
                <van-icon wx:if="{{item.id === 'confirm'}}" class="promotion-step__link" name="link-o" size="15px"
                    color="#1677ff" />
            </view>
            <view class="promotion-step__number">{{index + 1}}</view>
            <text class="promotion-step__label">{{item.label}}</text>
        </view>
    </view>

    <view class="promotion-notice">
        <van-icon name="info-o" size="22px" color="#f06a00" />
        <text>同一手机号的客户顾问预录信息与患者扫码信息会自动合并</text>
    </view>
    <text class="promotion-limit">客户绑定码仅限本人服务客户使用</text>
</view>
