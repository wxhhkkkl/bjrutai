page { background: #f4f3ee; }
.mall-flow-page { height: 100vh; display: flex; flex-direction: column; padding-bottom: env(safe-area-inset-bottom); background: #f4f3ee; box-sizing: border-box; }
.mall-flow-page > flow-navigation { flex: none; }
.mall-payment-content { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 95rpx 34rpx 24rpx; }
.mall-payment-mark { width: 128rpx; height: 128rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f3e9da; }
.mall-payment-mark--succeeded { background: #e1eee6; }
.mall-payment-mark--closed { background: #e9ebe7; }
.mall-payment-title { margin-top: 26rpx; color: #2c3b33; font-size: 34rpx; font-weight: 750; }
.mall-payment-message { max-width: 590rpx; margin-top: 14rpx; color: #748078; font-size: 23rpx; line-height: 1.7; text-align: center; }
.mall-payment-order-card { width: 100%; margin-top: 42rpx; padding: 24rpx; border: 1rpx solid #e7e9e2; border-radius: 18rpx; background: #fff; box-sizing: border-box; }
.mall-payment-order-card > view { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; padding: 13rpx 0; color: #7b8780; font-size: 22rpx; }
.mall-payment-order-card > view + view { border-top: 1rpx solid #f0f1ed; }
.mall-payment-order-card > view text:last-child { color: #3c4a42; text-align: right; }
.mall-payment-order-card .mall-payment-amount { color: #bd563f !important; font-size: 26rpx; font-weight: 700; }
.mall-payment-safety { margin-top: 18rpx; color: #9a765b; font-size: 20rpx; line-height: 1.6; text-align: center; }
.mall-payment-actions { width: 100%; display: flex; flex-direction: column; gap: 12rpx; padding: 0 26rpx calc(22rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.mall-primary-button,.mall-secondary-button { width: 100%; height: 82rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 650; line-height: 82rpx; }
.mall-primary-button { border: 0; color: #fff; background: #27645b; }
.mall-secondary-button { border: 1rpx solid #99afa4; color: #27645b; background: #fff; }
.mall-primary-button[disabled],.mall-secondary-button[disabled] { opacity: .55; }
