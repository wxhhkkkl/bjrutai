<view class="mall-flow-page mall-payment-page">
  <flow-navigation title="订单结果" bind:back="goBack" />
  <view class="mall-payment-content">
    <view class="mall-payment-mark mall-payment-mark--{{state}}"><van-icon name="{{state === 'succeeded' ? 'checked' : state === 'closed' ? 'close' : state === 'unknown' || state === 'error' ? 'warning-o' : 'clock-o'}}" size="36px" color="{{state === 'succeeded' ? '#1677FF' : state === 'closed' ? '#87918B' : '#BD704C'}}" /></view>
    <text class="mall-payment-title">{{title}}</text>
    <text class="mall-payment-message">{{message}}</text>
    <view wx:if="{{order}}" class="mall-payment-order-card">
      <view><text>订单号</text><text>{{order.orderNo || order.id}}</text></view>
      <view><text>订单状态</text><text>{{order.status === 'pending_payment' ? '待付款' : order.status === 'pending_shipment' ? (order.deliveryMethod === 'virtual' ? '待交付' : '待发货') : order.status === 'pending_receipt' ? '待收货' : order.status === 'closed' ? '已关闭' : order.status}}</text></view>
      <view><text>支付核实</text><text>{{statusLabel}}</text></view>
      <view><text>订单金额</text><text class="mall-payment-amount">¥{{order.payableAmountText}}</text></view>
    </view>
    <text wx:if="{{state === 'unknown' || state === 'error'}}" class="mall-payment-safety">请使用“查询支付状态”核对同一订单，不要新建订单来重试。</text>
  </view>
  <view class="mall-payment-actions">
    <button wx:if="{{canContinuePayment}}" class="mall-primary-button tap-target" bindtap="continuePayment" loading="{{paying}}" disabled="{{paying || querying}}" hover-class="tap-feedback">继续付款</button>
    <button wx:if="{{state === 'unknown' || state === 'error' || state === 'pending'}}" class="mall-secondary-button tap-target" bindtap="queryPayment" loading="{{querying}}" disabled="{{querying || paying}}" hover-class="tap-feedback">查询支付状态</button>
    <button wx:if="{{state === 'succeeded' || state === 'closed'}}" class="mall-primary-button tap-target" bindtap="backToMall" hover-class="tap-feedback">返回商城</button>
    <button wx:if="{{state === 'not_started' && !canContinuePayment}}" class="mall-secondary-button tap-target" bindtap="queryPayment" loading="{{querying}}" disabled="{{querying}}" hover-class="tap-feedback">查询订单状态</button>
  </view>
</view>
