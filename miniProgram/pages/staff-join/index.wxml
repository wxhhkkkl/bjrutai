<flow-navigation title="加入组织" bind:back="handleBack" />
<view class="scan-page">
  <view wx:if="{{state === 'loading'}}" class="scan-state">正在验证客户顾问加入码…</view>
  <view wx:elif="{{state === 'invalid'}}" class="scan-card scan-card--state">
    <van-icon name="warning-o" size="48px" color="#e65d4f" /><text class="scan-title">暂时无法加入</text><text class="scan-description">{{stateMessage}}</text>
  </view>
  <view wx:elif="{{state === 'success'}}" class="scan-card scan-card--state">
    <van-icon name="passed" size="54px" color="#20af6b" /><text class="scan-title">加入成功</text><text class="scan-description">您已成为{{result.organizationName}}的客户顾问，请重新登录后使用客户和消费功能。</text>
  </view>
  <block wx:else>
    <view class="scan-hero"><text class="scan-kicker">儒泰医联组织邀请</text><text class="scan-title">申请成为客户顾问</text><text class="scan-description">组织管理员 {{info.inviterName}} 邀请您加入 {{info.organizationName}}。</text></view>
    <view class="scan-card"><view class="scan-field"><text class="scan-field__label">真实姓名</text><input value="{{name}}" maxlength="20" placeholder="必填" bindinput="onNameInput" /></view></view>
    <view class="scan-consent tap-target" bindtap="toggleConsent" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80"><view class="scan-checkbox {{consentConfirmed ? 'scan-checkbox--checked' : ''}}"><van-icon wx:if="{{consentConfirmed}}" name="success" size="14px" color="#ffffff" /></view><text>我确认加入该组织，并同意使用姓名和手机号创建客户顾问账号</text></view>
    <button wx:if="{{consentConfirmed}}" class="scan-submit" open-type="getPhoneNumber" bindgetphonenumber="submit" loading="{{submitting}}" disabled="{{submitting}}">授权手机号并加入组织</button>
    <button wx:else class="scan-submit tap-target" bindtap="requestPhoneAuthorization" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80" loading="{{submitting}}" disabled="{{submitting}}">授权手机号并加入组织</button>
  </block>
</view>
