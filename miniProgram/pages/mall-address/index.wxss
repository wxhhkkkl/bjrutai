page { background: #f4f3ee; }
.mall-flow-page { height: 100vh; display: flex; flex-direction: column; padding-bottom: env(safe-area-inset-bottom); background: #f4f3ee; box-sizing: border-box; }
.mall-flow-page > flow-navigation { flex: none; }
.mall-flow-scroll { min-height: 0; flex: 1; }
.mall-address-content { padding: 18rpx 22rpx 36rpx; }
.mall-address-tip { margin: 0 4rpx 14rpx; color: #718078; font-size: 22rpx; }
.mall-address-card { position: relative; margin-bottom: 14rpx; padding: 22rpx; border: 1rpx solid #e8e9e2; border-radius: 18rpx; background: #fff; }
.mall-address-card--selectable:active { border-color: #92b3a5; }
.mall-address-card__top { display: flex; align-items: center; gap: 14rpx; }
.mall-address-card__name { color: #29372f; font-size: 27rpx; font-weight: 700; }
.mall-address-card__phone { color: #6f7c74; font-size: 22rpx; }
.mall-address-default { margin-left: auto; padding: 5rpx 12rpx; border-radius: 999rpx; color: #27645b; background: #e7f0eb; font-size: 19rpx; }
.mall-address-card__region { display: block; margin-top: 17rpx; color: #46554c; font-size: 23rpx; }
.mall-address-card__detail { display: block; margin-top: 8rpx; color: #89948d; font-size: 21rpx; }
.mall-address-card__action { margin-top: 16rpx; color: #27645b; font-size: 21rpx; text-align: right; }
.mall-address-empty { min-height: 290rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; color: #718078; font-size: 24rpx; }
.mall-empty-mark { width: 112rpx; height: 112rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e9eee8; }
.mall-address-form { margin-top: 16rpx; padding: 24rpx; border: 1rpx solid #e8e9e2; border-radius: 18rpx; background: #fff; }
.mall-address-form__heading { display: flex; justify-content: space-between; margin-bottom: 10rpx; color: #2d3b33; font-size: 28rpx; font-weight: 700; }
.mall-address-form__close { color: #7b8980; font-size: 22rpx; font-weight: 400; }
.mall-address-field { min-height: 86rpx; display: flex; align-items: center; gap: 16rpx; border-bottom: 1rpx solid #edf0eb; color: #34433a; font-size: 23rpx; }
.mall-address-field > text:first-child { width: 138rpx; flex: none; }
.mall-address-field input { min-width: 0; flex: 1; color: #34433a; font-size: 23rpx; }
.mall-address-field--picker { justify-content: space-between; }
.mall-address-field--picker > text:first-child { flex: none; }
.mall-address-field--picker .mall-address-value,.mall-address-field--picker .mall-address-placeholder { min-width: 0; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mall-address-placeholder { color: #a6afa9; }
.mall-address-field--textarea { min-height: 140rpx; align-items: flex-start; padding-top: 22rpx; box-sizing: border-box; }
.mall-address-field--textarea textarea { min-height: 105rpx; flex: 1; color: #34433a; font-size: 23rpx; }
.mall-address-option,.mall-address-consent { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; color: #59675f; font-size: 21rpx; }
.mall-address-consent { align-items: flex-start; color: #3e594e; line-height: 1.55; }
.mall-address-purpose { margin: 16rpx 0 0 52rpx; padding: 14rpx 16rpx; border-radius: 12rpx; color: #68746c; background: #f5f7f3; font-size: 18rpx; line-height: 1.6; }
.mall-address-policy { display: block; margin: 12rpx 0 0 52rpx; color: #9aa39d; font-size: 18rpx; }
.mall-check { width: 36rpx; height: 36rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 2rpx solid #bdc7bf; border-radius: 50%; color: #fff; font-size: 22rpx; box-sizing: border-box; }
.mall-check--selected { border-color: #27645b; background: #27645b; }
.mall-primary-button { min-width: 210rpx; height: 82rpx; padding: 0 34rpx; border: 0; border-radius: 999rpx; color: #fff; background: #27645b; font-size: 27rpx; font-weight: 650; line-height: 82rpx; }
.mall-primary-button[disabled] { background: #b6c0ba; }
.mall-address-save { display: block; width: 100%; margin-top: 24rpx; }
.mall-address-add { width: 100%; height: 82rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; margin: 12rpx 0 30rpx; border: 1rpx dashed #91ab9e; border-radius: 16rpx; color: #27645b; background: #fff; font-size: 24rpx; }
.mall-flow-state { min-height: 55vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; padding: 40rpx; color: #7a8980; font-size: 24rpx; text-align: center; }
.mall-flow-state__title { color: #34443b; font-size: 30rpx; font-weight: 700; }
.mall-flow-state__hint { color: #88958e; font-size: 22rpx; }
.mall-inline-message { display: block; margin: 10rpx 0; color: #a24e3d; font-size: 21rpx; }
