page {
  background: #ffffff;
}

.records-page {
  min-height: 100vh;
  padding: 21rpx 36rpx calc(42rpx + constant(safe-area-inset-bottom));
  padding: 21rpx 36rpx calc(42rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 58%, #ffffff 100%);
}

.records-overview {
  min-height: 322rpx;
  padding: 31rpx 36rpx 27rpx;
  background: linear-gradient(118deg, #edf7ff 0%, #f7fbff 47%, #eaf4ff 100%);
  border: 1rpx solid #edf4fc;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(28, 69, 124, 0.065);
}

.records-overview__title,
.records-overview__subtitle {
  display: block;
}

.records-overview__title {
  color: #050505;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.records-overview__subtitle {
  margin-top: 12rpx;
  color: #5f6670;
  font-size: 24rpx;
  line-height: 1.3;
}

.records-summary {
  margin-top: 29rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.summary-item {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 19rpx;
  flex: 1;
}

.summary-icon {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 21rpx;
}

.summary-icon--green,
.record-icon--green {
  background: linear-gradient(145deg, #e7f8ef, #f4fbf7);
}

.summary-icon--blue,
.record-icon--blue {
  background: linear-gradient(145deg, #e5f1ff, #f5f9ff);
}

.summary-icon--orange,
.record-icon--orange {
  background: linear-gradient(145deg, #fff0db, #fff8eb);
}

.summary-icon__link {
  position: absolute;
  right: 14rpx;
  bottom: 19rpx;
}

.summary-icon__check,
.record-icon__check {
  position: absolute;
  right: 3rpx;
  bottom: 5rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #079447;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
}

.summary-icon__check {
  width: 34rpx;
  height: 34rpx;
}

.summary-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.summary-label {
  color: #14171b;
  font-size: 24rpx;
  line-height: 1;
  white-space: nowrap;
}

.summary-value {
  color: #050505;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
}

.status-help {
  min-height: 55rpx;
  margin-top: 13rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  color: #1677ff;
  font-size: 24rpx;
  border-radius: 15rpx;
}

.records-search {
  height: 77rpx;
  margin-top: 28rpx;
  padding: 0 25rpx;
  display: flex;
  align-items: center;
  gap: 17rpx;
  background: #ffffff;
  border: 1rpx solid #dfe3e9;
  border-radius: 29rpx;
  box-shadow: 0 7rpx 17rpx rgba(27, 49, 83, 0.045);
}

.records-search__input {
  min-width: 0;
  height: 100%;
  flex: 1;
  color: #23272e;
  font-size: 27rpx;
}

.records-search__placeholder {
  color: #858b95;
}

.records-filter {
  height: 88rpx;
  margin-top: 15rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.records-filter__pill {
  min-width: 0;
  height: 61rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  color: #565c65;
  font-size: 23rpx;
  line-height: 1;
  white-space: nowrap;
  background: #ffffff;
  border: 1rpx solid #e1e5eb;
  border-radius: 999rpx;
}

.records-filter__pill:first-child {
  flex: 0.9;
}

.records-filter__pill--active {
  color: #ffffff;
  background: #1677ff;
  border-color: #1677ff;
  box-shadow: 0 8rpx 18rpx rgba(22, 119, 255, 0.2);
}

.records-filter__button {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: #ffffff;
  border: 1rpx solid #dfe3e9;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 15rpx rgba(27, 49, 83, 0.06);
}

.records-list-header {
  height: 78rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.records-list-title {
  color: #050505;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.records-list-count {
  color: #838993;
  font-size: 24rpx;
  line-height: 1;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 13rpx;
}

.record-card {
  position: relative;
  min-height: 133rpx;
  padding: 18rpx 25rpx 18rpx 17rpx;
  display: flex;
  align-items: center;
  gap: 25rpx;
  background: #ffffff;
  border: 1rpx solid #edf0f4;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 21rpx rgba(27, 49, 83, 0.052);
}

.record-icon {
  position: relative;
  width: 102rpx;
  height: 102rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 21rpx;
}

.record-icon__link {
  position: absolute;
  right: 12rpx;
  bottom: 18rpx;
}

.record-icon__check {
  right: 1rpx;
  bottom: 1rpx;
  width: 31rpx;
  height: 31rpx;
}

.record-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
}

.record-name {
  overflow: hidden;
  color: #050505;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.05;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.record-phone,
.record-note,
.record-detail {
  overflow: hidden;
  color: #4e5560;
  font-size: 22rpx;
  line-height: 1.05;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.record-detail {
  color: #858b95;
}

.record-status {
  min-width: 114rpx;
  height: 51rpx;
  padding: 0 13rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  flex: none;
  font-size: 22rpx;
  line-height: 1;
  white-space: nowrap;
  background: #ffffff;
  border: 1rpx solid currentColor;
  border-radius: 17rpx;
}

.record-status--green {
  color: #079447;
}

.record-status--blue {
  color: #1677ff;
}

.record-status--orange {
  color: #ff6a00;
}

.record-arrow {
  flex: none;
}

.records-empty {
  min-height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 20rpx;
  color: #8a909b;
  font-size: 25rpx;
}

.records-sync-note {
  min-height: 62rpx;
  margin-top: 14rpx;
  padding: 10rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 19rpx;
  color: #4b515a;
  font-size: 23rpx;
  line-height: 1.35;
  background: linear-gradient(90deg, #f2f8ff, #edf5ff);
  border-radius: 24rpx;
}

.records-sync-note__icon {
  width: 39rpx;
  height: 39rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: #1677ff;
  border-radius: 50%;
}

.records-primary {
  height: 93rpx;
  margin-top: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 600;
  line-height: 1;
  background: #050505;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.1);
}

@media (max-width: 340px) {
  .records-page {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }

  .records-overview {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .records-summary {
    gap: 10rpx;
  }

  .summary-item {
    gap: 10rpx;
  }

  .summary-icon {
    width: 90rpx;
    height: 90rpx;
  }

  .records-filter {
    gap: 7rpx;
  }

  .records-filter__pill {
    padding: 0 12rpx;
    font-size: 21rpx;
  }

  .record-card {
    gap: 15rpx;
    padding-right: 17rpx;
  }

  .record-icon {
    width: 92rpx;
    height: 92rpx;
  }
}
