<app-header title="消费" />

<view class="contribution-screen tab-screen">
  <view class="contribution-banner">
    <image
      class="contribution-banner__visual"
      src="/assets/images/contribution-banner-visual.png"
      mode="aspectFill"
      aria-role="img"
      aria-label="消费增长数据视觉"
    />
    <view class="contribution-banner__copy">
      <text class="contribution-banner__label">本月消费金额</text>
      <view class="contribution-banner__amount">
        <text class="contribution-banner__number">{{overview.amount}}</text>
      </view>
      <view class="contribution-banner__growth">
        <van-icon name="upgrade" size="17px" color="#1677ff" />
        <text>较上月 {{overview.growth}}</text>
      </view>
      <text class="contribution-banner__description">
        消费金额持续累积
      </text>
    </view>
  </view>

  <page-state state="{{state}}" bind:retry="retry" />

  <block wx:if="{{state === 'success'}}">
    <view class="period-tabs">
      <view
        wx:for="{{periods}}"
        wx:key="id"
        class="period-tab tap-target {{selectedPeriod === item.id ? 'period-tab--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectPeriod"
        hover-class="tap-feedback"
        hover-start-time="0"
        hover-stay-time="80"
      >
        {{item.label}}
      </view>
    </view>

    <view class="trend-card">
      <view class="trend-card__header">
        <text class="contribution-title">消费趋势</text>
        <view class="trend-card__total">
          <text>{{chartSummary.label}}</text>
          <text class="trend-card__total-number">{{chartSummary.total}}</text>
        </view>
      </view>
      <view hidden="{{!hasTrendData}}" class="trend-chart" aria-label="{{chartSummary.label}} {{chartSummary.total}}">
        <ec-canvas
          id="contribution-trend-chart"
          canvas-id="contribution-trend-chart"
          ec="{{ec}}"
        ></ec-canvas>
      </view>
      <view wx:if="{{!hasTrendData}}" class="contribution-empty contribution-empty--trend" aria-label="暂无消费趋势数据">
        <view class="contribution-empty__icon contribution-empty__icon--trend">
          <van-icon name="bar-chart-o" size="44px" color="#8bb4ed" />
        </view>
        <text class="contribution-empty__title">暂无消费趋势</text>
        <text class="contribution-empty__hint">有消费记录后，趋势将在这里展示</text>
      </view>
    </view>

    <view class="detail-card">
      <view class="detail-card__header">
        <text class="contribution-title">近期消费明细</text>
        <view
          class="detail-card__all tap-target"
          bindtap="openAllDetails"
          hover-class="tap-feedback"
          hover-start-time="0"
          hover-stay-time="80"
          aria-role="button"
          aria-label="查看全部消费明细"
        >
          <text>查看全部</text>
          <van-icon name="arrow" size="19px" color="#1677ff" />
        </view>
      </view>

      <view wx:if="{{hasDetails}}" class="detail-list">
        <view
          wx:for="{{details}}"
          wx:key="title"
          class="detail-row tap-target"
          data-title="{{item.title}}"
          bindtap="openDetail"
          hover-class="tap-feedback"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <image class="detail-icon" src="{{item.icon}}" mode="aspectFill" />
          <view class="detail-copy">
            <text class="detail-title">{{item.title}}</text>
            <text class="detail-meta">{{item.meta}}</text>
          </view>
          <view class="detail-value">
            <text>{{item.value}}</text>
          </view>
          <van-icon name="arrow" size="22px" color="#8a8f98" />
        </view>
      </view>
      <view wx:else class="contribution-empty contribution-empty--details" aria-label="暂无消费明细">
        <view class="contribution-empty__icon contribution-empty__icon--details">
          <van-icon name="records-o" size="40px" color="#9aaed0" />
        </view>
        <text class="contribution-empty__title">暂无消费明细</text>
        <text class="contribution-empty__hint">产生消费记录后，会显示在这里</text>
      </view>
    </view>
  </block>
</view>
