<app-header title="贡献" />

<view class="contribution-screen tab-screen">
  <view class="contribution-banner">
    <image
      class="contribution-banner__visual"
      src="/assets/images/contribution-banner-visual.png"
      mode="aspectFill"
      aria-role="img"
      aria-label="贡献增长数据视觉"
    />
    <view class="contribution-banner__copy">
      <text class="contribution-banner__label">本月贡献</text>
      <view class="contribution-banner__amount">
        <text class="contribution-banner__number">{{overview.amount}}</text>
        <text class="contribution-banner__unit">分</text>
      </view>
      <view class="contribution-banner__growth">
        <van-icon name="upgrade" size="17px" color="#1677ff" />
        <text>较上月 {{overview.growth}}</text>
      </view>
      <text class="contribution-banner__description">
        持续服务，贡献持续累积
      </text>
    </view>
  </view>

  <page-state state="{{state}}" bind:retry="retry" />

  <block wx:if="{{state === 'success'}}">
    <view class="period-tabs">
      <view
        wx:for="{{periods}}"
        wx:key="id"
        class="period-tab tap-target {{selectedPeriod === item.id ? 'period-tab--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectPeriod"
        hover-class="tap-feedback"
        hover-start-time="0"
        hover-stay-time="80"
      >
        {{item.label}}
      </view>
    </view>

    <view class="trend-card">
      <view class="trend-card__header">
        <text class="contribution-title">贡献趋势</text>
        <view class="trend-card__total">
          <text>{{chartSummary.label}}</text>
          <text class="trend-card__total-number">{{chartSummary.total}}</text>
        </view>
      </view>
      <view class="trend-chart" aria-label="{{chartSummary.label}} {{chartSummary.total}}">
        <ec-canvas
          id="contribution-trend-chart"
          canvas-id="contribution-trend-chart"
          ec="{{ec}}"
        ></ec-canvas>
      </view>
    </view>

    <view class="composition-card">
      <text class="contribution-title">贡献构成</text>
      <view class="composition-content">
        <view class="composition-item">
          <image
            class="composition-icon"
            src="/assets/images/contribution-bind-icon.png"
            mode="aspectFill"
          />
          <view class="composition-copy">
            <text class="composition-label">客户绑定</text>
            <view class="composition-value">
              <text>{{composition.binding}}</text>
              <text class="composition-unit">分</text>
            </view>
          </view>
        </view>
        <view class="composition-divider"></view>
        <view class="composition-item composition-item--service">
          <image
            class="composition-icon"
            src="/assets/images/contribution-service-icon.png"
            mode="aspectFill"
          />
          <view class="composition-copy">
            <text class="composition-label">服务完成</text>
            <view class="composition-value">
              <text>{{composition.service}}</text>
              <text class="composition-unit">分</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="detail-card">
      <view class="detail-card__header">
        <text class="contribution-title">近期贡献明细</text>
        <view
          class="detail-card__all tap-target"
          bindtap="openAllDetails"
          hover-class="tap-feedback"
          hover-start-time="0"
          hover-stay-time="80"
          aria-role="button"
          aria-label="查看全部贡献明细"
        >
          <text>查看全部</text>
          <van-icon name="arrow" size="19px" color="#1677ff" />
        </view>
      </view>

      <view class="detail-list">
        <view
          wx:for="{{details}}"
          wx:key="title"
          class="detail-row tap-target"
          data-title="{{item.title}}"
          bindtap="openDetail"
          hover-class="tap-feedback"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <image class="detail-icon" src="{{item.icon}}" mode="aspectFill" />
          <view class="detail-copy">
            <text class="detail-title">{{item.title}}</text>
            <text class="detail-meta">{{item.meta}}</text>
          </view>
          <view class="detail-value">
            <text>{{item.value}}</text>
            <text class="detail-unit">分</text>
          </view>
          <van-icon name="arrow" size="22px" color="#8a8f98" />
        </view>
      </view>
    </view>
  </block>
</view>
