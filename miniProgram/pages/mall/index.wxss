page {
  background: #f4f3ee;
}

.mall-screen {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(132rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f4f3ee;
}

.mall-screen > app-header {
  flex: none;
}

.mall-toolbar {
  flex: none;
  padding: 12rpx 24rpx 0;
  background: #ffffff;
}

.mall-search {
  height: 78rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border: 1rpx solid #eeefeb;
  border-radius: 18rpx;
  background: #f3f4f1;
  box-sizing: border-box;
}

.mall-search__input {
  min-width: 0;
  height: 100%;
  flex: 1;
  margin-left: 14rpx;
  color: #26332e;
  font-size: 25rpx;
}

.mall-search__input::placeholder {
  color: #a0a7a2;
}

.mall-search__clear {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -8rpx;
}

.mall-loading-icon {
  animation: mall-spin 900ms linear infinite;
}

@keyframes mall-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.mall-filter-row {
  height: 88rpx;
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  border-bottom: 1rpx solid #eceeea;
}

.mall-cart-entry {
  width: 68rpx;
  height: 68rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  border-radius: 999rpx;
  background: #eef3ee;
}

.mall-filter-item {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #737d77;
  font-size: 25rpx;
  font-weight: 500;
}

.mall-filter-item--price {
  min-width: 150rpx;
}

.mall-filter-item--category {
  min-width: 170rpx;
  max-width: 250rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.mall-filter-item--category text {
  max-width: 190rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mall-filter-item--active {
  color: #27645b;
  font-weight: 700;
}

.mall-filter-item__arrows {
  display: flex;
  flex-direction: column;
  gap: 0;
  line-height: 0;
}

.mall-filter-divider {
  width: 1rpx;
  height: 34rpx;
  background: #e7eae5;
}

.mall-scroll {
  min-height: 0;
  flex: 1;
}

.mall-content {
  min-height: 100%;
  padding: 22rpx 24rpx 34rpx;
  box-sizing: border-box;
}

.mall-grid {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  flex-wrap: wrap;
}

.mall-product-card {
  width: calc((100% - 20rpx) / 2);
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1rpx solid #e9e8e1;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 16rpx rgba(43, 55, 48, 0.035);
  box-sizing: border-box;
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.mall-product-card__image-wrap {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 100%;
  overflow: hidden;
  background: #eeefeb;
}

.mall-product-card__image,
.mall-product-card__image-empty {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.mall-product-card__image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eeefeb;
}

.mall-product-card__soldout {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.64);
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(39, 49, 44, 0.72);
  font-size: 20rpx;
  line-height: 1.2;
}

.mall-product-card__body {
  min-height: 132rpx;
  padding: 16rpx 18rpx 18rpx;
  box-sizing: border-box;
}

.mall-product-card__name {
  height: 68rpx;
  display: -webkit-box;
  overflow: hidden;
  color: #27332e;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.38;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.mall-product-card__price-row {
  min-width: 0;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 6rpx;
  margin-top: 9rpx;
}

.mall-product-card__price {
  min-width: 0;
  color: #bd563f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.1;
  white-space: nowrap;
}

.mall-product-card__currency {
  margin-right: 2rpx;
  font-size: 22rpx;
}

.mall-product-card__stock {
  overflow: hidden;
  color: #8d9690;
  font-size: 19rpx;
  line-height: 1.3;
  text-align: right;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mall-product-card__stock--available {
  color: #54786e;
}

.mall-state {
  min-height: 540rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 44rpx 32rpx;
  color: #7d8881;
  text-align: center;
  box-sizing: border-box;
}

.mall-state__title {
  margin-top: 22rpx;
  color: #29352f;
  font-size: 30rpx;
  font-weight: 650;
}

.mall-state__message {
  margin-top: 12rpx;
  color: #8b948e;
  font-size: 24rpx;
  line-height: 1.55;
}

.mall-state__action {
  min-width: 206rpx;
  height: 72rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  color: #ffffff;
  background: #27645b;
  border: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 72rpx;
}

.mall-load-more {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #8d9690;
  font-size: 22rpx;
}

.mall-load-more--error {
  flex-wrap: wrap;
  color: #9c634e;
}

.mall-load-more__retry {
  padding: 10rpx 12rpx;
  color: #27645b;
  font-weight: 600;
}

.mall-sheet-backdrop {
  position: fixed;
  z-index: 50;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 33, 29, 0.34);
}

.mall-category-sheet {
  width: 100%;
  max-height: 72vh;
  overflow: hidden;
  padding: 12rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.mall-category-sheet__header {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf0ec;
}

.mall-category-sheet__title {
  color: #28352f;
  font-size: 29rpx;
  font-weight: 700;
}

.mall-category-sheet__close {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mall-category-sheet__options {
  max-height: 55vh;
  overflow-y: auto;
  padding-top: 8rpx;
}

.mall-category-option {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
  border-bottom: 1rpx solid #f0f1ee;
  color: #53605a;
  font-size: 26rpx;
}

.mall-category-option--selected {
  color: #27645b;
  font-weight: 700;
}
