page {
  background: #f4f7f5;
}

.mall-screen {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: calc(132rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.mall-screen > app-header {
  flex: none;
}

.mall-scroll {
  flex: 1;
  min-height: 0;
}

.mall-content {
  padding: 18rpx 24rpx 42rpx;
}

.mall-search {
  height: 74rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(34, 79, 65, 0.04);
}

.mall-search__placeholder {
  margin-left: 14rpx;
  color: #9aa7a3;
  font-size: 26rpx;
}

.mall-search__hint {
  margin-left: auto;
  color: #8ba59b;
  font-size: 23rpx;
}

.mall-shelf {
  display: flex;
  align-items: stretch;
  overflow: hidden;
  border: 1rpx solid #e8eeea;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(32, 70, 59, 0.05);
}

.mall-shelf__sidebar {
  width: 150rpx;
  flex: none;
  padding: 12rpx 0;
  background: #f7f9f7;
}

.mall-side-category {
  min-height: 90rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  border-left: 5rpx solid transparent;
  box-sizing: border-box;
  color: #6d7c76;
  font-size: 24rpx;
  line-height: 1.35;
}

.mall-side-category--active {
  border-left-color: #208a76;
  color: #167564;
  background: #ffffff;
  font-weight: 700;
}

.mall-products {
  min-width: 0;
  flex: 1;
  padding: 4rpx 16rpx 4rpx 14rpx;
}

.mall-product {
  min-height: 176rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf1ef;
  box-sizing: border-box;
}

.mall-product:last-child {
  border-bottom: 0;
}

.mall-product__art {
  width: 132rpx;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  overflow: hidden;
  border-radius: 18rpx;
}

.mall-product__art--monitor {
  background: #e4f0ea;
}

.mall-product__art--book {
  background: #f7eee1;
}

.mall-product__art--pouch {
  background: #e8eef7;
}

.mall-product__art--care {
  background: #f9eae8;
}

.product-object {
  position: relative;
  box-shadow: 0 8rpx 14rpx rgba(57, 77, 69, 0.12);
}

.product-object--monitor {
  width: 82rpx;
  height: 68rpx;
  border: 5rpx solid #e3e8e2;
  border-radius: 15rpx;
  background: #fffef9;
}

.product-object__screen {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  right: 10rpx;
  height: 27rpx;
  border-radius: 6rpx;
  background: #dce9e2;
}

.product-object__button {
  position: absolute;
  bottom: 7rpx;
  left: 50%;
  width: 13rpx;
  height: 6rpx;
  border-radius: 8rpx;
  background: #7ba998;
  transform: translateX(-50%);
}

.product-object--book {
  width: 62rpx;
  height: 86rpx;
  border: 3rpx solid #c69b64;
  border-radius: 7rpx 13rpx 13rpx 7rpx;
  background: #fffaf0;
  transform: rotate(-6deg);
}

.product-object__book-page {
  position: absolute;
  top: 0;
  right: 8rpx;
  width: 3rpx;
  height: 100%;
  background: #e6d5b8;
}

.product-object__book-line {
  position: absolute;
  top: 28rpx;
  left: 14rpx;
  width: 27rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #d2bd9e;
}

.product-object--pouch {
  width: 67rpx;
  height: 75rpx;
  border: 3rpx solid #8fa3c5;
  border-radius: 30rpx 30rpx 22rpx 22rpx;
  background: #c9d6e9;
  transform: rotate(7deg);
}

.product-object__pouch-seam {
  position: absolute;
  top: 15rpx;
  left: 12rpx;
  width: 38rpx;
  height: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 50%;
}

.product-object--care {
  width: 69rpx;
  height: 77rpx;
  border: 3rpx solid #dc9991;
  border-radius: 11rpx;
  background: #fff9f6;
}

.product-object__care-ribbon {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 9rpx;
  background: #df8d83;
  transform: translateX(-50%);
}

.product-object__care-bow {
  position: absolute;
  top: 12rpx;
  left: 50%;
  width: 34rpx;
  height: 14rpx;
  border: 3rpx solid #df8d83;
  border-radius: 50%;
  background: #fff9f6;
  box-sizing: border-box;
  transform: translateX(-50%);
}

.product-object__care-bow::after {
  position: absolute;
  top: 3rpx;
  left: 50%;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #df8d83;
  content: '';
  transform: translateX(-50%);
}

.mall-product__info {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.mall-product__topline {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mall-product__category {
  color: #398c79;
  font-size: 20rpx;
}

.mall-product__badge {
  padding: 3rpx 8rpx;
  border-radius: 6rpx;
  color: #a58554;
  background: #f7f0e4;
  font-size: 18rpx;
}

.mall-product__name {
  width: 100%;
  margin-top: 6rpx;
  overflow: hidden;
  color: #273d37;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.35;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mall-product__description {
  width: 100%;
  margin-top: 4rpx;
  overflow: hidden;
  color: #85938e;
  font-size: 22rpx;
  line-height: 1.35;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mall-product__status {
  margin-top: 9rpx;
  color: #9aa7a2;
  font-size: 20rpx;
}
