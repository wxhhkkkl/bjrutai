<view class="mall-screen">
  <app-header title="商城" />

  <view class="mall-toolbar">
    <view class="mall-search">
      <van-icon name="search" size="20px" color="#69756F" />
      <input
        class="mall-search__input"
        type="text"
        maxlength="128"
        confirm-type="search"
        placeholder="请输入商品名称"
        value="{{searchText}}"
        bindinput="onSearchInput"
        bindconfirm="submitSearch"
        aria-label="搜索商品" adjust-position="true" cursor-spacing="80" />
      <view
        wx:if="{{searchText}}"
        class="mall-search__clear tap-target"
        bindtap="clearSearch"
        hover-class="tap-feedback"
        hover-start-time="0"
        hover-stay-time="80"
        aria-role="button"
        aria-label="清除搜索"
      >
        <van-icon name="clear" size="17px" color="#8A938E" />
      </view>
    </view>

    <view class="mall-filter-row" aria-label="商品排序和分类筛选">
      <view
        class="mall-filter-item mall-filter-item--price tap-target {{sortMode !== 'default' ? 'mall-filter-item--active' : ''}}"
        bindtap="togglePriceSort"
        hover-class="tap-feedback"
        hover-start-time="0"
        hover-stay-time="80"
        aria-role="button"
        aria-label="按价格排序"
      >
        <text>价格</text>
        <view class="mall-filter-item__arrows" aria-hidden="true">
          <van-icon name="arrow-up" size="10px" color="{{sortMode === 'price_asc' ? '#1677FF' : '#B4BAB6'}}" />
          <van-icon name="arrow-down" size="10px" color="{{sortMode === 'price_desc' ? '#1677FF' : '#B4BAB6'}}" />
        </view>
      </view>
      <view class="mall-filter-divider" />
      <view
        class="mall-filter-item mall-filter-item--category tap-target {{selectedCategoryId ? 'mall-filter-item--active' : ''}}"
        bindtap="openCategoryFilter"
        hover-class="tap-feedback"
        hover-start-time="0"
        hover-stay-time="80"
        aria-role="button"
        aria-label="按分类筛选"
      >
        <text>{{selectedCategoryName}}</text>
        <van-icon name="arrow-down" size="14px" color="{{selectedCategoryId ? '#1677FF' : '#8A938E'}}" />
      </view>
    </view>
  </view>

  <scroll-view
    class="mall-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    refresher-default-style="black"
    bindrefresherrefresh="onRefresherRefresh"
    lower-threshold="140"
    bindscrolltolower="onReachBottom"
  >
    <view class="mall-content">
      <view wx:if="{{state === 'loading'}}" class="mall-state" aria-role="status">
        <van-icon class="mall-loading-icon" name="replay" size="28px" color="#1677FF" />
        <text class="mall-state__message">正在加载商品</text>
      </view>

      <view wx:elif="{{state === 'success'}}" class="mall-grid" aria-role="list" aria-label="商品列表">
        <view
          wx:for="{{products}}"
          wx:key="id"
          class="mall-product-card tap-target"
          bindtap="openProduct"
          data-id="{{item.id}}"
          hover-class="tap-feedback"
          hover-start-time="0"
          hover-stay-time="80"
          aria-role="listitem"
          aria-label="{{item.name}}，价格{{item.priceText}}元{{item.availabilityText ? '，' + item.availabilityText : ''}}"
        >
          <view class="mall-product-card__image-wrap">
            <image
              wx:if="{{item.coverUrl}}"
              class="mall-product-card__image"
              src="{{item.coverUrl}}"
              mode="aspectFill"
              lazy-load="{{true}}"
              aria-role="img"
              aria-label="{{item.name}}"
            />
            <view wx:else class="mall-product-card__image-empty" aria-label="暂无商品图片">
              <van-icon name="photo-o" size="28px" color="#AEB8B2" />
            </view>
            <view wx:if="{{item.availability === 'sold_out'}}" class="mall-product-card__soldout">
              <text>暂时售罄</text>
            </view>
          </view>
          <view class="mall-product-card__body">
            <text class="mall-product-card__name">{{item.name}}</text>
            <view class="mall-product-card__price-row">
              <view class="mall-product-card__price-group">
                <view class="mall-product-card__price">
                  <text class="mall-product-card__currency">¥</text>
                  <text>{{item.priceText}}</text>
                </view>
                <text wx:if="{{item.marketPriceText}}" class="mall-product-card__market-price">¥{{item.marketPriceText}}</text>
              </view>
              <view
                wx:if="{{item.availability === 'available'}}"
                class="mall-product-card__add tap-target"
                catchtap="addCardProduct"
                data-id="{{item.id}}"
                hover-class="tap-feedback"
                aria-role="button"
                aria-label="{{item.skus.length > 1 ? '选择规格' : '加入购物车'}}"
              >
                <view class="mall-product-card__add-icon" id="mall-product-add-{{item.id}}">
                  <van-icon name="{{addingProductId == item.id ? 'replay' : 'shopping-cart-o'}}" size="18px" color="#FFFFFF" />
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:elif="{{state === 'empty'}}" class="mall-state">
        <van-icon name="search" size="34px" color="#9AA49E" />
        <text class="mall-state__title">暂时没有找到商品</text>
        <text class="mall-state__message">试试更短的关键词，或清除筛选条件</text>
        <button class="mall-state__action tap-target" bindtap="clearFilters" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">清除筛选</button>
      </view>

      <view wx:elif="{{state === 'forbidden'}}" class="mall-state">
        <van-icon name="lock" size="32px" color="#9AA49E" />
        <text class="mall-state__title">商城暂不可访问</text>
        <text class="mall-state__message">{{stateMessage}}</text>
      </view>

      <view wx:elif="{{state === 'recoverable-error'}}" class="mall-state">
        <van-icon name="warning-o" size="32px" color="#A96D4D" />
        <text class="mall-state__title">商品暂时没有加载出来</text>
        <text class="mall-state__message">{{stateMessage}}</text>
        <button class="mall-state__action tap-target" bindtap="retry" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">重新加载</button>
      </view>

      <view wx:if="{{state === 'success' && loadingMore}}" class="mall-load-more" aria-role="status">
        <van-icon class="mall-loading-icon" name="replay" size="18px" color="#84918A" />
        <text>正在加载更多</text>
      </view>
      <view wx:elif="{{state === 'success' && loadMoreError}}" class="mall-load-more mall-load-more--error">
        <text>{{loadMoreError}}</text>
        <text class="mall-load-more__retry tap-target" bindtap="onReachBottom" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">点击重试</text>
      </view>
      <view wx:elif="{{state === 'success' && !hasMore && products.length > 0}}" class="mall-load-more">
        <text>已经到底了</text>
      </view>
    </view>
  </scroll-view>

  <mall-floating-cart id="mall-floating-cart" above-tab-bar="{{true}}" />
  <view
    wx:for="{{cartFlights}}"
    wx:for-item="flight"
    wx:key="id"
    class="mall-cart-fly"
    style="left: {{flight.left}}px; top: {{flight.top}}px; width: {{flight.size}}px; height: {{flight.size}}px; --cart-fly-x: {{flight.deltaX}}px; --cart-fly-y: {{flight.deltaY}}px;"
    aria-hidden="true"
  >
    <view class="mall-cart-fly__icon">
      <van-icon name="shopping-cart-o" size="18px" color="#FFFFFF" />
    </view>
  </view>

  <view wx:if="{{categoryFilterVisible}}" class="mall-sheet-backdrop tap-target" bindtap="closeCategoryFilter" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80" catchtouchmove="stopPropagation">
    <view class="mall-category-sheet" catchtap="stopPropagation">
      <view class="mall-category-sheet__header">
        <text class="mall-category-sheet__title">选择分类</text>
        <view class="mall-category-sheet__close tap-target" bindtap="closeCategoryFilter" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80" aria-role="button" aria-label="关闭分类筛选">
          <van-icon name="cross" size="20px" color="#66716B" />
        </view>
      </view>
      <view class="mall-category-sheet__options">
        <view
          wx:for="{{categoryOptions}}"
          wx:key="id"
          class="mall-category-option tap-target {{selectedCategoryId === item.id ? 'mall-category-option--selected' : ''}}"
          bindtap="selectCategory"
          data-id="{{item.id}}"
          hover-class="tap-feedback"
          hover-start-time="0"
          hover-stay-time="80"
          aria-role="button"
        >
          <text>{{item.name}}</text>
          <van-icon wx:if="{{selectedCategoryId === item.id}}" name="success" size="16px" color="#1677FF" />
        </view>
      </view>
    </view>
  </view>
</view>
