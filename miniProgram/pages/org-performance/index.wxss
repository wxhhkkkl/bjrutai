.org-performance-screen {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

/* Period selector */
.period-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.period-chip {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #606266;
  font-size: 24rpx;
  border: 1rpx solid #e4e7ed;
}

.period-chip--active {
  background: #1677ff;
  color: #fff;
  border-color: #1677ff;
}

/* Org summary card */
.org-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.org-card__name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111318;
  display: block;
  margin-bottom: 24rpx;
}

.org-card__summary {
  display: flex;
}

.org-card__metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.org-card__metric--divider {
  border-left: 1rpx solid #ebeef5;
  padding-left: 32rpx;
}

.org-card__label {
  font-size: 24rpx;
  color: #909399;
}

.org-card__value {
  font-size: 40rpx;
  font-weight: 700;
  color: #111318;
}

.org-card__unit {
  font-size: 22rpx;
  color: #909399;
}

/* Sections */
.section-block {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 16rpx;
  display: block;
}

.sub-org-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
}

.sub-org-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.sub-org-row:last-child {
  border-bottom: none;
}

.sub-org-row__name {
  font-size: 28rpx;
  color: #303133;
}

.sub-org-row__metric {
  font-size: 24rpx;
  color: #606266;
}

/* Member table */
.member-table {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
}

.member-table__head,
.member-table__row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 26rpx;
}

.member-table__head {
  color: #909399;
  border-bottom: 1rpx solid #f2f2f2;
}

.member-table__row {
  color: #303133;
  border-bottom: 1rpx solid #f2f2f2;
}

.member-table__row:last-child {
  border-bottom: none;
}

.member-note {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #c0c4cc;
}

/* No permission / error states */
.no-permission {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding-top: 160rpx;
}

.no-permission__text {
  font-size: 26rpx;
  color: #909399;
}

/* 008 US3: 提成区块 */
.commission-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}
.commission-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 27rpx;
  color: #303133;
}
.commission-row--confirmed {
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  margin-bottom: 8rpx;
}
.commission-row__label { color: #606266; }
.commission-row__amount { color: #409eff; font-weight: 600; }
