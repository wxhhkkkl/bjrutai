.org-performance-screen {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 24rpx 32rpx calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* Period selector */
.period-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.period-chip {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #606266;
  font-size: 24rpx;
  border: 1rpx solid #e4e7ed;
}

.period-chip--active {
  background: #1677ff;
  color: #fff;
  border-color: #1677ff;
}

/* Org summary card */
.org-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.org-card__name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111318;
  display: block;
  margin-bottom: 24rpx;
}

.org-card__summary {
  display: flex;
}

.org-card__metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.org-card__metric--divider {
  border-left: 1rpx solid #ebeef5;
  padding-left: 32rpx;
}

.org-card__label {
  font-size: 24rpx;
  color: #909399;
}

.org-card__value {
  font-size: 40rpx;
  font-weight: 700;
  color: #111318;
}

.org-card__unit {
  font-size: 22rpx;
  color: #909399;
}

/* Sections */
.section-block {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 16rpx;
  display: block;
}

.sub-org-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
}

.sub-org-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.sub-org-row:last-child {
  border-bottom: none;
}

.sub-org-row__name {
  font-size: 28rpx;
  color: #303133;
}

.sub-org-row__metric {
  font-size: 24rpx;
  color: #606266;
}

/* Member table */
.member-table {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
}

.member-table__head,
.member-table__row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 26rpx;
}

.member-table__head {
  color: #909399;
  border-bottom: 1rpx solid #f2f2f2;
}

.member-table__row {
  color: #303133;
  border-bottom: 1rpx solid #f2f2f2;
}

.member-table__row:last-child {
  border-bottom: none;
}

.member-note {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #c0c4cc;
}

/* No permission / error states */
.no-permission {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding-top: 160rpx;
}

.no-permission__text {
  font-size: 26rpx;
  color: #909399;
}

/* 008 US3: 提成区块 */
.commission-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}
.commission-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 27rpx;
  color: #303133;
}
.commission-row--confirmed {
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  margin-bottom: 8rpx;
}
.commission-row__label { color: #606266; }
.commission-row__amount { color: #409eff; font-weight: 600; }

.commission-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.commission-heading .section-title {
  margin-bottom: 4rpx;
}

.commission-heading__month {
  display: block;
  color: #858b95;
  font-size: 22rpx;
}

.period-status {
  flex: none;
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: #f0f2f5;
  color: #707783;
  font-size: 22rpx;
}

.period-status--frozen {
  background: #e8f5ef;
  color: #16845b;
}

.period-status--estimate {
  background: #edf5ff;
  color: #1677ff;
}

.commission-card {
  border: 1rpx solid #edf0f4;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(27, 49, 83, 0.045);
}

.commission-row {
  gap: 16rpx;
}

.commission-row__sub {
  display: block;
  margin-top: 5rpx;
  color: #858b95;
  font-size: 20rpx;
}

.commission-summary {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #f0f2f5;
}

.commission-summary__item {
  width: 50%;
  box-sizing: border-box;
  padding: 10rpx 0;
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  color: #7b828d;
  font-size: 22rpx;
}

.commission-summary__item text:last-child {
  color: #3a414c;
  font-variant-numeric: tabular-nums;
}

.commission-negative { color: #cb5c4c !important; }
.commission-positive { color: #16845b !important; }

.member-table__title {
  display: block;
  padding: 20rpx 0 4rpx;
  border-top: 1rpx solid #f0f2f5;
  color: #555d68;
  font-size: 24rpx;
  font-weight: 600;
}

.commission-card .member-table {
  padding: 0;
  background: transparent;
}

.commission-card .member-table__row {
  display: block;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f3f6;
}

.member-table__top {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  align-items: baseline;
}

.member-table__name {
  color: #303642;
  font-size: 25rpx;
  font-weight: 600;
}

.member-table__net {
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.member-table__details {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 9rpx;
  color: #858b95;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.commission-empty {
  padding: 24rpx 0 8rpx;
  color: #858b95;
  font-size: 23rpx;
  text-align: center;
}

.commission-card--confirmed {
  padding: 18rpx 24rpx;
  margin-bottom: 12rpx;
}

.commission-row--net {
  margin-top: 6rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f2f5;
}
