<flow-navigation title="组织业绩" bind:back="handleBack" />

<view class="org-performance-screen">
  <page-state
    state="{{state}}"
    message="{{state === 'forbidden' ? '当前账号非组织管理员，无权限查看组织业绩' : '请稍后再试'}}"
    bind:retry="retry"
  />

  <block wx:if="{{state === 'success'}}">
    <!-- Period selector -->
    <view class="period-bar">
      <view
        wx:for="{{months}}"
        wx:key="*this"
        class="period-chip {{selectedMonth === item ? 'period-chip--active' : ''}} tap-target"
        hover-class="tap-feedback"
        hover-start-time="0"
        hover-stay-time="80"
        data-month="{{item}}"
        bindtap="selectMonth"
      >{{item}}</view>
    </view>

    <!-- Org summary -->
    <view class="org-card">
      <text class="org-card__name">{{orgName}}</text>
      <view class="org-card__summary">
        <view class="org-card__metric">
          <text class="org-card__label">本月消费</text>
          <text class="org-card__value">¥{{fmtYuan(summary.thisMonth)}}</text>
        </view>
        <view class="org-card__metric org-card__metric--divider">
          <text class="org-card__label">累计消费</text>
          <text class="org-card__value">¥{{fmtYuan(summary.cumulative)}}</text>
        </view>
      </view>
    </view>

    <view class="section-block" wx:if="{{commission}}">
      <view class="commission-heading">
        <view>
          <text class="section-title">组织绩效</text>
          <text class="commission-heading__month">{{commission.currentMonth.month}}</text>
        </view>
        <text wx:if="{{commission.currentMonth.isFrozen}}" class="period-status period-status--frozen">已冻结</text>
        <text wx:elif="{{commission.currentMonth.isEstimate}}" class="period-status period-status--estimate">实时预估</text>
        <text wx:else class="period-status">状态待核实</text>
      </view>
      <view class="commission-card">
        <view class="commission-row">
          <view>
            <text class="commission-row__label">组织可兑现</text>
            <text class="commission-row__sub">正常绩效和已确认调整合并展示</text>
          </view>
          <text class="commission-row__amount">¥{{fmtYuan(commission.currentMonth.summary.redeemableCent)}}</text>
        </view>
        <view class="commission-summary">
          <view class="commission-summary__item">
            <text>正常绩效</text>
            <text>¥{{fmtYuan(commission.currentMonth.summary.normalCommissionCent)}}</text>
          </view>
          <view class="commission-summary__item">
            <text>调整</text>
            <text class="{{commission.currentMonth.summary.confirmedAdjustmentCent < 0 ? 'commission-negative' : 'commission-positive'}}">{{fmtSignedYuan(commission.currentMonth.summary.confirmedAdjustmentCent)}}</text>
          </view>
          <view class="commission-summary__item">
            <text>已抵债</text>
            <text>¥{{fmtYuan(commission.currentMonth.summary.appliedDebtCent)}}</text>
          </view>
          <view class="commission-summary__item">
            <text>待抵扣</text>
            <text>¥{{fmtYuan(commission.currentMonth.summary.pendingDebtCent)}}</text>
          </view>
        </view>
        <view wx:if="{{commission.currentMonth.members.length}}" class="member-table">
          <text class="member-table__title">成员绩效</text>
          <view
            wx:for="{{commission.currentMonth.members}}"
            wx:key="distributorId"
            class="member-table__row"
          >
            <view class="member-table__top">
              <text class="member-table__name">{{item.name}}</text>
              <text class="member-table__net">可兑现 ¥{{fmtYuan(item.redeemableCent)}}</text>
            </view>
            <view class="member-table__details">
              <text>正常 ¥{{fmtYuan(item.normalCommissionCent)}}</text>
              <text>调整 {{fmtSignedYuan(item.confirmedAdjustmentCent)}}</text>
              <text>已抵债 ¥{{fmtYuan(item.appliedDebtCent)}}</text>
              <text>待抵扣 ¥{{fmtYuan(item.pendingDebtCent)}}</text>
            </view>
          </view>
        </view>
        <view wx:else class="commission-empty">当前月份暂无可展示绩效</view>
      </view>
      <view
        wx:for="{{commission.confirmed}}"
        wx:key="month"
        class="commission-card commission-card--confirmed"
      >
        <view class="commission-heading">
          <text class="commission-heading__month">{{item.month}}</text>
          <text class="period-status period-status--frozen">已冻结</text>
        </view>
        <view class="commission-row">
          <text class="commission-row__label">正常绩效</text>
          <text>¥{{fmtYuan(item.summary.normalCommissionCent)}}</text>
        </view>
        <view class="commission-row">
          <text class="commission-row__label">调整 / 已抵债</text>
          <text>{{fmtSignedYuan(item.summary.confirmedAdjustmentCent)}} / ¥{{fmtYuan(item.summary.appliedDebtCent)}}</text>
        </view>
        <view class="commission-row commission-row--net">
          <text class="commission-row__label">可兑现</text>
          <text class="commission-row__amount">¥{{fmtYuan(item.summary.redeemableCent)}}</text>
        </view>
      </view>
    </view>

    <!-- Sub orgs -->
    <view class="section-block" wx:if="{{subOrgs.length}}">
      <text class="section-title">下级组织</text>
      <view class="sub-org-list">
        <view
          wx:for="{{subOrgs}}"
          wx:key="orgId"
          class="sub-org-row tap-target"
          hover-class="tap-feedback"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <text class="sub-org-row__name">{{item.orgName}}</text>
          <text class="sub-org-row__metric">本月 ¥{{fmtYuan(item.thisMonth)}} · 累计 ¥{{fmtYuan(item.cumulative)}}</text>
        </view>
      </view>
    </view>

    <!-- Members -->
    <view class="section-block" wx:if="{{members.length}}">
      <text class="section-title">成员消费</text>
      <view class="member-table">
        <view class="member-table__head">
          <text>成员</text>
          <text>本月</text>
          <text>累计</text>
        </view>
        <view
          wx:for="{{members}}"
          wx:key="distributorId"
          class="member-table__row"
        >
          <text>{{item.name}}</text>
          <text>¥{{fmtYuan(item.thisMonth)}}</text>
          <text>¥{{fmtYuan(item.cumulative)}}</text>
        </view>
      </view>
      <text class="member-note">消费金额仅显示数值，不含客户级明细</text>
    </view>
  </block>
</view>
