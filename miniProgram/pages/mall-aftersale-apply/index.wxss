@import "../../styles/interactions.wxss";

page { background: #f4f3ee; }
.mall-flow-page { height: 100vh; display: flex; flex-direction: column; background: #f4f3ee; box-sizing: border-box; }
.mall-flow-page > flow-navigation { flex: none; }
.mall-flow-scroll { min-height: 0; flex: 1; }
.mall-aftersale-content { padding: 18rpx 22rpx 28rpx; }
.mall-aftersale-banner { display: flex; align-items: center; gap: 16rpx; margin-bottom: 14rpx; padding: 24rpx; border: 1rpx solid #e6eae3; border-radius: 18rpx; background: #fff; }
.mall-aftersale-banner__mark { width: 76rpx; height: 76rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eaf1ff; }
.mall-aftersale-banner__title, .mall-aftersale-banner__hint { display: block; }
.mall-aftersale-banner__title { color: #33443a; font-size: 31rpx; font-weight: 700; }
.mall-aftersale-banner__hint { margin-top: 8rpx; color: #859188; font-size: 24rpx; }
.mall-aftersale-section { margin-bottom: 14rpx; padding: 22rpx; border: 1rpx solid #e8e9e2; border-radius: 18rpx; background: #fff; }
.mall-section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; color: #2c3b33; font-size: 29rpx; font-weight: 700; }
.mall-muted, .mall-helper { color: #929b95; font-size: 24rpx; font-weight: 400; line-height: 1.55; }
.mall-aftersale-option { min-height: 84rpx; display: flex; align-items: center; gap: 14rpx; padding: 13rpx 14rpx; border: 1rpx solid #edf0eb; border-radius: 14rpx; background: #fbfcfa; }
.mall-aftersale-option + .mall-aftersale-option { margin-top: 10rpx; }
.mall-aftersale-option--selected { border-color: #a4bfff; background: #edf2ff; }
.mall-choice { width: 36rpx; height: 36rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 2rpx solid #c4cdc6; border-radius: 50%; color: #fff; font-size: 22rpx; box-sizing: border-box; }
.mall-choice--selected { border-color: #1677ff; background: #1677ff; }
.mall-aftersale-option__copy { display: flex; flex-direction: column; gap: 6rpx; color: #435249; font-size: 26rpx; }
.mall-aftersale-option__copy text:last-child { color: #929b95; font-size: 24rpx; font-weight: 400; }
.mall-aftersale-item { min-height: 112rpx; display: flex; align-items: center; gap: 12rpx; padding: 14rpx 0; border-top: 1rpx solid #eff0eb; }
.mall-aftersale-item__copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 7rpx; }
.mall-aftersale-item__name { overflow: hidden; color: #35443c; font-size: 26rpx; font-weight: 650; white-space: nowrap; text-overflow: ellipsis; }
.mall-aftersale-item__unavailable { color: #9ba39d; font-size: 24rpx; }
.mall-quantity { flex: none; display: flex; align-items: center; gap: 14rpx; color: #3d4b43; font-size: 26rpx; }
.mall-quantity__button { width: 56rpx; height: 56rpx; margin: 0; padding: 0; border: 1rpx solid #dce3dd; border-radius: 50%; color: #1677ff; background: #fff; font-size: 30rpx; line-height: 54rpx; }
.mall-quantity__button[disabled] { color: #b8c0bb; background: #f5f6f3; }
.mall-required { color: #bd563f; font-size: 24rpx; font-weight: 500; }
.mall-aftersale-input, .mall-aftersale-textarea { width: 100%; box-sizing: border-box; padding: 20rpx; border: 1rpx solid #e8ebe6; border-radius: 12rpx; color: #405047; background: #fbfcfa; font-size: 25rpx; }
.mall-aftersale-input { height: 84rpx; padding: 0 20rpx; line-height: 84rpx; }
.mall-aftersale-textarea { min-height: 145rpx; margin-top: 12rpx; line-height: 1.5; }
.mall-proof-list { display: flex; flex-wrap: wrap; gap: 20rpx; }
.mall-proof-item { position: relative; width: 160rpx; height: 160rpx; flex: none; overflow: visible; border: 1rpx solid #dce7f8; border-radius: 14rpx; background: #eef5ff; }
.mall-proof-item__thumb { width: 100%; height: 100%; border-radius: 14rpx; }
.mall-proof-item__remove { position: absolute; top: -12rpx; right: -12rpx; z-index: 2; width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid #fff; border-radius: 50%; background: #30343b; }
.mall-proof-button { width: 100%; height: 80rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; margin: 10rpx 0 0; padding: 0; border: 1rpx dashed #b9cdf5; border-radius: 13rpx; color: #1677ff; background: #fbfcfa; font-size: 25rpx; line-height: 78rpx; }
.mall-flow-state { min-height: 55vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; padding: 40rpx; color: #7a8980; font-size: 28rpx; text-align: center; }
.mall-flow-state__title { color: #34443b; font-size: 34rpx; font-weight: 700; }
.mall-primary-button { min-width: 210rpx; height: 86rpx; padding: 0 34rpx; border: 0; border-radius: 999rpx; color: #fff; background: #1677ff; font-size: 29rpx; font-weight: 650; line-height: 86rpx; }
.mall-primary-button[disabled] { background: #b6c0ba; }
.mall-aftersale-footer { flex: none; padding: 12rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e7e8e2; background: #fff; }
.mall-aftersale-submit { display: block; width: 100%; margin-top: 9rpx; }
