@import "../../styles/interactions.wxss";

page { background: #f4f3ee; }
.mall-flow-page { height: 100vh; display: flex; flex-direction: column; padding-bottom: env(safe-area-inset-bottom); background: #f4f3ee; box-sizing: border-box; }
.mall-flow-page > flow-navigation { flex: none; }
.mall-flow-scroll { min-height: 0; flex: 1; }
.mall-aftersale-content { padding: 18rpx 22rpx 28rpx; }
.mall-aftersale-banner { display: flex; align-items: center; gap: 16rpx; margin-bottom: 14rpx; padding: 22rpx; border: 1rpx solid #e6eae3; border-radius: 18rpx; background: #fff; }
.mall-aftersale-banner__mark { width: 70rpx; height: 70rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #edf3ed; }
.mall-aftersale-banner__title, .mall-aftersale-banner__hint { display: block; }
.mall-aftersale-banner__title { color: #33443a; font-size: 27rpx; font-weight: 700; }
.mall-aftersale-banner__hint { margin-top: 7rpx; color: #859188; font-size: 19rpx; }
.mall-aftersale-section { margin-bottom: 14rpx; padding: 22rpx; border: 1rpx solid #e8e9e2; border-radius: 18rpx; background: #fff; }
.mall-section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; color: #2c3b33; font-size: 25rpx; font-weight: 700; }
.mall-muted, .mall-helper { color: #929b95; font-size: 19rpx; font-weight: 400; line-height: 1.55; }
.mall-aftersale-option { min-height: 78rpx; display: flex; align-items: center; gap: 13rpx; padding: 11rpx 12rpx; border: 1rpx solid #edf0eb; border-radius: 14rpx; background: #fbfcfa; }
.mall-aftersale-option + .mall-aftersale-option { margin-top: 10rpx; }
.mall-aftersale-option--selected { border-color: #9ab5a5; background: #f3f7f2; }
.mall-choice { width: 34rpx; height: 34rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 2rpx solid #c4cdc6; border-radius: 50%; color: #fff; font-size: 20rpx; box-sizing: border-box; }
.mall-choice--selected { border-color: #27645b; background: #27645b; }
.mall-aftersale-option__copy { display: flex; flex-direction: column; gap: 5rpx; color: #435249; font-size: 22rpx; }
.mall-aftersale-option__copy text:last-child { color: #929b95; font-size: 18rpx; font-weight: 400; }
.mall-aftersale-item { min-height: 104rpx; display: flex; align-items: center; gap: 10rpx; padding: 12rpx 0; border-top: 1rpx solid #eff0eb; }
.mall-aftersale-item__copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.mall-aftersale-item__name { overflow: hidden; color: #35443c; font-size: 22rpx; font-weight: 650; white-space: nowrap; text-overflow: ellipsis; }
.mall-aftersale-item__unavailable { color: #9ba39d; font-size: 18rpx; }
.mall-quantity { display: flex; align-items: center; gap: 12rpx; color: #3d4b43; font-size: 22rpx; }
.mall-quantity__button { width: 52rpx; height: 52rpx; margin: 0; padding: 0; border: 1rpx solid #dce3dd; border-radius: 50%; color: #27645b; background: #fff; font-size: 28rpx; line-height: 50rpx; }
.mall-quantity__button[disabled] { color: #b8c0bb; background: #f5f6f3; }
.mall-required { color: #bd563f; font-size: 19rpx; font-weight: 500; }
.mall-aftersale-input, .mall-aftersale-textarea { width: 100%; box-sizing: border-box; padding: 19rpx; border: 1rpx solid #e8ebe6; border-radius: 12rpx; color: #405047; background: #fbfcfa; font-size: 21rpx; }
.mall-aftersale-textarea { min-height: 135rpx; margin-top: 12rpx; line-height: 1.5; }
.mall-proof-list { display: flex; flex-direction: column; gap: 8rpx; }
.mall-proof-chip { display: flex; align-items: center; gap: 12rpx; min-height: 50rpx; color: #58675e; font-size: 19rpx; }
.mall-proof-chip text:first-child { min-width: 0; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mall-proof-chip__verified { color: #27645b; }
.mall-proof-chip__remove { padding: 8rpx 0 8rpx 12rpx; color: #a24e3d; }
.mall-proof-button { width: 100%; height: 72rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; margin: 10rpx 0 0; padding: 0; border: 1rpx dashed #b8c9bd; border-radius: 13rpx; color: #27645b; background: #fbfcfa; font-size: 21rpx; line-height: 70rpx; }
.mall-aftersale-notice { display: flex; flex-direction: column; gap: 8rpx; padding: 16rpx 8rpx 20rpx; color: #859188; font-size: 19rpx; line-height: 1.5; }
.mall-aftersale-notice text:first-child { color: #a24e3d; font-weight: 650; }
.mall-inline-message { display: block; margin: 8rpx 4rpx 18rpx; color: #a24e3d; font-size: 21rpx; line-height: 1.5; }
.mall-flow-state { min-height: 55vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; padding: 40rpx; color: #7a8980; font-size: 24rpx; text-align: center; }
.mall-flow-state__title { color: #34443b; font-size: 30rpx; font-weight: 700; }
.mall-primary-button { min-width: 210rpx; height: 82rpx; padding: 0 34rpx; border: 0; border-radius: 999rpx; color: #fff; background: #27645b; font-size: 27rpx; font-weight: 650; line-height: 82rpx; }
.mall-primary-button[disabled] { background: #b6c0ba; }
.mall-aftersale-footer { flex: none; padding: 12rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e7e8e2; background: #fff; }
.mall-aftersale-submit { display: block; width: 100%; margin-top: 9rpx; }
