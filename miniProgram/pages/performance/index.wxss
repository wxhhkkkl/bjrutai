.perf-screen {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: #f5f7fa;
}

.est-card,
.conf-card {
  background: #ffffff;
  border: 1rpx solid #edf0f4;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(27, 49, 83, 0.045);
}

.est-card {
  padding: 28rpx;
}

.est-card__heading,
.conf-card__heading,
.rule-card__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.est-card__title {
  display: block;
  color: #111318;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.est-card__month {
  display: block;
  margin-top: 6rpx;
  color: #858b95;
  font-size: 23rpx;
}

.period-status {
  flex: none;
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: #f0f2f5;
  color: #707783;
  font-size: 22rpx;
}

.period-status--frozen {
  background: #e8f5ef;
  color: #16845b;
}

.period-status--estimate {
  background: #edf5ff;
  color: #1677ff;
}

.estimate-note,
.frozen-note {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 1.5;
}

.estimate-note {
  background: #f2f7ff;
  color: #4a6d9f;
}

.frozen-note {
  background: #f0f8f4;
  color: #48735e;
}

.rule-card {
  margin-top: 20rpx;
  padding: 20rpx 0 2rpx;
  border-top: 1rpx solid #edf0f4;
}

.rule-card__title {
  color: #303642;
  font-size: 27rpx;
  font-weight: 600;
}

.redeemable-amount {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  color: #1677ff;
  font-size: 23rpx;
}

.redeemable-amount text:last-child {
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.rule-card__base {
  display: block;
  margin-top: 10rpx;
  color: #858b95;
  font-size: 22rpx;
}

.amount-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
  padding: 16rpx 0 8rpx;
  border-top: 1rpx solid #f0f2f5;
}

.amount-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 7rpx 0 11rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.amount-cell__label {
  color: #858b95;
  font-size: 22rpx;
}

.amount-cell__value {
  color: #303642;
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
}

.amount-cell__value--negative {
  color: #cb5c4c;
}

.amount-cell__value--positive {
  color: #16845b;
}

.est-empty,
.conf-empty {
  padding: 38rpx 0;
  color: #8b929d;
  font-size: 25rpx;
  text-align: center;
}

.conf-title {
  margin: 32rpx 8rpx 16rpx;
  color: #303642;
  font-size: 28rpx;
  font-weight: 700;
}

.conf-card {
  margin-bottom: 14rpx;
  padding: 22rpx 26rpx;
}

.conf-card__month {
  color: #303642;
  font-size: 26rpx;
  font-weight: 600;
}

.history-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
  padding-top: 18rpx;
  color: #747b86;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.history-row__label {
  width: 100%;
  color: #4a515c;
  font-size: 23rpx;
  font-weight: 600;
}

@media (max-width: 350px) {
  .est-card {
    padding: 24rpx 20rpx;
  }

  .amount-cell {
    padding-right: 8rpx;
  }
}
