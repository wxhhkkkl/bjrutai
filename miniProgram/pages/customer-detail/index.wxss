page {
    background: #ffffff;
}

.detail-page {
    min-height: 100vh;
    padding: 20rpx 30rpx calc(154rpx + constant(safe-area-inset-bottom));
    padding: 20rpx 30rpx calc(154rpx + env(safe-area-inset-bottom));
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 62%, #ffffff 100%);
}

.customer-hero {
    position: relative;
    min-height: 372rpx;
    overflow: hidden;
    padding: 38rpx 38rpx 28rpx;
    display: grid;
    grid-template-columns: 170rpx minmax(0, 1fr);
    grid-template-rows: 205rpx 111rpx;
    column-gap: 31rpx;
    background: linear-gradient(118deg, #eff7ff 0%, #f7fbff 50%, #e9f3ff 100%);
    border: 1rpx solid #edf3fa;
    border-radius: 29rpx;
    box-shadow: 0 10rpx 24rpx rgba(30, 64, 111, 0.05);
}

.customer-hero__arc {
    position: absolute;
    right: -126rpx;
    border: 2rpx solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    pointer-events: none;
}

.customer-hero__arc--outer {
    top: 57rpx;
    width: 392rpx;
    height: 279rpx;
}

.customer-hero__arc--inner {
    top: 97rpx;
    width: 334rpx;
    height: 226rpx;
}

.customer-hero__avatar {
    position: relative;
    z-index: 1;
    width: 170rpx;
    height: 170rpx;
    border-radius: 26rpx;
}

.customer-hero__identity {
    position: relative;
    z-index: 1;
    min-width: 0;
    display: flex;
    align-items: flex-start;
    flex-direction: column;
}

.customer-hero__name {
    color: #050505;
    font-size: 39rpx;
    font-weight: 700;
    line-height: 1.1;
}

.customer-hero__phone {
    margin-top: 13rpx;
    color: #454b54;
    font-size: 27rpx;
    line-height: 1.1;
}

.customer-hero__status {
    min-height: 42rpx;
    margin-top: 14rpx;
    padding: 0 12rpx;
    display: flex;
    align-items: center;
    gap: 7rpx;
    color: #1677ff;
    font-size: 22rpx;
    line-height: 1;
    background: #ffffff;
    border: 1rpx solid #1677ff;
    border-radius: 14rpx;
}

.customer-hero__date {
    margin-top: 13rpx;
    color: #5f6670;
    font-size: 20rpx;
    line-height: 1.1;
}

.customer-hero__edit {
    position: absolute;
    z-index: 2;
    top: 120rpx;
    right: 22rpx;
    min-width: 158rpx;
    height: 56rpx;
    padding: 0 14rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10rpx;
    color: #15191e;
    font-size: 22rpx;
    background: #ffffff;
    border-radius: 20rpx;
    box-shadow: 0 8rpx 18rpx rgba(25, 50, 84, 0.12);
}

.customer-hero__metrics {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    display: flex;
    align-items: stretch;
}

.customer-metric {
    position: relative;
    min-width: 0;
    display: flex;
    align-items: center;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 13rpx;
}

.customer-metric+.customer-metric::before {
    content: "";
    position: absolute;
    top: 11rpx;
    bottom: 10rpx;
    left: 0;
    width: 1rpx;
    background: #d5dce6;
}

.customer-metric__label {
    color: #545b65;
    font-size: 24rpx;
    line-height: 1;
}

.customer-metric__value {
    color: #050505;
    font-size: 39rpx;
    font-weight: 600;
    line-height: 1;
}

.customer-metric__unit {
    margin-left: 5rpx;
    font-size: 25rpx;
    font-weight: 400;
}

.detail-tabs {
    height: 75rpx;
    margin-top: 24rpx;
    padding: 2rpx;
    display: flex;
    background: #ffffff;
    border: 1rpx solid #dfe3e9;
    border-radius: 23rpx;
}

.detail-tab {
    min-width: 0;
    height: 69rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    color: #696f79;
    font-size: 29rpx;
    line-height: 1;
    border-radius: 20rpx;
}

.detail-tab--active {
    color: #ffffff;
    background: #1677ff;
    box-shadow: 0 7rpx 15rpx rgba(22, 119, 255, 0.2);
}

.detail-section-title {
    display: block;
    margin: 29rpx 5rpx 16rpx;
    color: #050505;
    font-size: 33rpx;
    font-weight: 700;
    line-height: 1.2;
}

.detail-card {
    background: #ffffff;
    border: 1rpx solid #edf0f4;
    border-radius: 27rpx;
    box-shadow: 0 9rpx 22rpx rgba(28, 53, 88, 0.055);
}

.binding-info-card {
    padding: 0 22rpx;
}

.binding-info-row {
    min-height: 91rpx;
    display: flex;
    align-items: center;
    gap: 25rpx;
    border-bottom: 1rpx solid #e4e8ee;
    border-radius: 14rpx;
}

.binding-info-row--last {
    border-bottom: 0;
}

.detail-icon {
    width: 67rpx;
    height: 67rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    border-radius: 15rpx;
}

.detail-icon--blue {
    background: linear-gradient(145deg, #e8f3ff, #f5f9ff);
}

.detail-icon--green {
    background: linear-gradient(145deg, #e5f8ec, #f3fbf6);
}

.detail-icon--purple {
    background: linear-gradient(145deg, #f0e9ff, #faf7ff);
}

.binding-info-row__label {
    color: #20242a;
    font-size: 25rpx;
    line-height: 1.2;
}

.binding-info-row__status {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8rpx;
    font-size: 23rpx;
    white-space: nowrap;
}

.binding-info-row__status--blue {
    color: #1677ff;
}

.binding-info-row__status--green {
    color: #12a147;
}

.binding-owner {
    min-width: 0;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8rpx;
}

.binding-owner__id {
    color: #727984;
    font-size: 20rpx;
}

.binding-info-row__owner {
    color: #6f7680;
    font-size: 24rpx;
}

.customer-profile-card {
    padding: 20rpx 26rpx 15rpx;
}

.profile-row {
    min-height: 43rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30rpx;
    color: #555d68;
    font-size: 24rpx;
}

.profile-row>text:last-child {
    overflow: hidden;
    text-align: right;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.profile-privacy {
    min-height: 47rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9rpx;
    color: #1677ff;
    font-size: 19rpx;
}

.followup-card {
    min-height: 128rpx;
    padding: 18rpx 24rpx;
    display: flex;
    align-items: center;
    gap: 27rpx;
    background: linear-gradient(110deg, #f5fcf8, #fbfefd);
    border: 1rpx solid #e2f1e7;
    border-radius: 27rpx;
    box-shadow: 0 9rpx 22rpx rgba(28, 53, 88, 0.045);
}

.followup-card__icon {
    width: 91rpx;
    height: 91rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    background: #e7f8ee;
    border-radius: 19rpx;
}

.followup-card__copy {
    min-width: 0;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 13rpx;
}

.followup-card__title {
    color: #11151a;
    font-size: 27rpx;
    font-weight: 600;
}

.followup-card__time {
    color: #69717c;
    font-size: 22rpx;
}

.followup-card__status {
    min-width: 93rpx;
    height: 49rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    color: #139d35;
    font-size: 22rpx;
    border: 1rpx solid #139d35;
    border-radius: 17rpx;
}

.service-overview {
    min-height: 129rpx;
    padding: 19rpx 0;
    display: flex;
    align-items: stretch;
    background: #ffffff;
    border: 1rpx solid #e4e8ee;
    border-radius: 25rpx;
}

.service-overview__item {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 16rpx;
    color: #565d67;
    font-size: 24rpx;
}

.service-overview__item+.service-overview__item::before,
.contribution-overview__item+.contribution-overview__item::before {
    content: "";
    position: absolute;
    top: 13rpx;
    bottom: 13rpx;
    left: 0;
    width: 1rpx;
    background: #dfe4eb;
}

.service-overview__value {
    color: #050505;
    font-size: 36rpx;
    line-height: 1;
}

.service-overview__value--blue {
    color: #1677ff;
}

.service-overview__value--green {
    color: #139d35;
}

.service-timeline {
    position: relative;
    margin: 0 5rpx;
    padding-left: 48rpx;
}

.service-timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 8rpx;
    left: 11rpx;
    width: 2rpx;
    background: #e1e6ed;
}

.service-record {
    position: relative;
    min-height: 139rpx;
    padding: 25rpx 5rpx 25rpx 0;
    display: flex;
    align-items: center;
    gap: 37rpx;
    border-bottom: 1rpx solid #e4e8ee;
    border-radius: 14rpx;
}

.service-record:last-child {
    border-bottom: 0;
}

.service-record__node {
    position: absolute;
    z-index: 1;
    top: 63rpx;
    left: -48rpx;
    width: 23rpx;
    height: 23rpx;
    background: #ffffff;
    border: 3rpx solid currentColor;
    border-radius: 50%;
    box-shadow: inset 0 0 0 4rpx #ffffff;
}

.service-record__node::after {
    content: "";
    position: absolute;
    top: 4rpx;
    right: 4rpx;
    bottom: 4rpx;
    left: 4rpx;
    background: currentColor;
    border-radius: 50%;
}

.service-record__node--blue {
    color: #1677ff;
}

.service-record__node--green {
    color: #139d35;
}

.service-record__icon {
    width: 92rpx;
    height: 92rpx;
    border-radius: 18rpx;
}

.service-record__copy {
    min-width: 0;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14rpx;
}

.service-record__title {
    color: #101419;
    font-size: 27rpx;
    font-weight: 600;
}

.service-record__time {
    color: #69717c;
    font-size: 22rpx;
}

.service-record__status {
    min-width: 103rpx;
    height: 51rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    font-size: 22rpx;
    border: 1rpx solid currentColor;
    border-radius: 17rpx;
}

.service-record__status--blue {
    color: #1677ff;
}

.service-record__status--green {
    color: #139d35;
}

.detail-notice {
    min-height: 70rpx;
    margin-top: 14rpx;
    padding: 14rpx 29rpx;
    display: flex;
    align-items: center;
    gap: 20rpx;
    color: #2e5e9f;
    font-size: 22rpx;
    background: linear-gradient(90deg, #f4f8ff, #edf5ff);
    border: 1rpx solid #d8e9ff;
    border-radius: 20rpx;
}

.contribution-overview {
    min-height: 161rpx;
    display: flex;
    background: #ffffff;
    border: 1rpx solid #e4e8ee;
    border-radius: 25rpx;
}

.contribution-overview__item {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 22rpx;
    color: #656c76;
    font-size: 23rpx;
}

.contribution-overview__value {
    display: flex;
    align-items: baseline;
    color: #1677ff;
    font-size: 39rpx;
    line-height: 1;
}

.contribution-overview__value>text:last-child {
    margin-left: 7rpx;
    font-size: 25rpx;
}

.contribution-filters {
    height: 89rpx;
    display: flex;
    align-items: center;
    gap: 18rpx;
}

.contribution-filter {
    height: 55rpx;
    padding: 0 25rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #505761;
    font-size: 24rpx;
    background: #ffffff;
    border: 1rpx solid #dfe3e9;
    border-radius: 15rpx;
}

.contribution-filter--active {
    color: #ffffff;
    background: #1677ff;
    border-color: #1677ff;
}

.contribution-list {
    padding: 0 24rpx;
}

.contribution-row {
    min-height: 116rpx;
    display: flex;
    align-items: center;
    gap: 29rpx;
    border-bottom: 1rpx solid #e4e8ee;
}

.contribution-row:last-child {
    border-bottom: 0;
}

.contribution-row__icon {
    width: 79rpx;
    height: 79rpx;
}

.contribution-row__copy {
    min-width: 0;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 13rpx;
}

.contribution-row__title {
    color: #101419;
    font-size: 25rpx;
    font-weight: 500;
}

.contribution-row__time {
    color: #737a84;
    font-size: 20rpx;
}

.contribution-row__points {
    display: flex;
    align-items: baseline;
    color: #1677ff;
    font-size: 30rpx;
    white-space: nowrap;
}

.contribution-row__points>text:last-child {
    margin-left: 5rpx;
    font-size: 21rpx;
}

.detail-notice--contribution {
    color: #1677ff;
}

.customer-action-bar {
    position: fixed;
    z-index: 30;
    right: 0;
    bottom: 0;
    left: 0;
    min-height: 124rpx;
    padding: 19rpx 30rpx calc(19rpx + constant(safe-area-inset-bottom));
    padding: 19rpx 30rpx calc(19rpx + env(safe-area-inset-bottom));
    display: flex;
    gap: 25rpx;
    background: rgba(255, 255, 255, 0.98);
    border-top: 1rpx solid #e5e9ef;
}

.customer-action {
    height: 75rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 17rpx;
    flex: 1;
    font-size: 29rpx;
    line-height: 1;
    border-radius: 999rpx;
}

.customer-action--contact {
    color: #1677ff;
    background: #ffffff;
    border: 1rpx solid #a9c7ee;
}

.customer-action--followup {
    color: #ffffff;
    background: #050505;
    box-shadow: 0 9rpx 18rpx rgba(0, 0, 0, 0.1);
}

@media (max-width: 350px) {
    .detail-page {
        padding-right: 24rpx;
        padding-left: 24rpx;
    }

    .customer-hero {
        padding-right: 25rpx;
        padding-left: 25rpx;
        grid-template-columns: 151rpx minmax(0, 1fr);
        column-gap: 23rpx;
    }

    .customer-hero__avatar {
        width: 151rpx;
        height: 151rpx;
    }

    .customer-hero__name {
        font-size: 36rpx;
    }

    .service-record {
        gap: 23rpx;
    }

    .customer-action-bar {
        gap: 17rpx;
        padding-right: 24rpx;
        padding-left: 24rpx;
    }
}