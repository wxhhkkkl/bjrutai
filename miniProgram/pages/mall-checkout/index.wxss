page { background: #f4f3ee; }
.mall-flow-page { height: 100vh; display: flex; flex-direction: column; background: #f4f3ee; box-sizing: border-box; }
.mall-flow-page > flow-navigation { flex: none; }
.mall-flow-scroll { min-height: 0; flex: 1; }
.mall-checkout-content { padding: 18rpx 22rpx 28rpx; }
.mall-checkout-section { margin-bottom: 14rpx; padding: 22rpx; border: 1rpx solid #e8e9e2; border-radius: 18rpx; background: #fff; }
.mall-section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; color: #2c3b33; font-size: 30rpx; font-weight: 700; }
.mall-link { color: #1677ff; font-size: 26rpx; font-weight: 500; }
.mall-checkout-address { display: flex; align-items: flex-start; gap: 14rpx; padding: 16rpx; border: 1rpx solid #e8ebe6; border-radius: 14rpx; background: #fbfcf9; }
.mall-checkout-address + .mall-checkout-address { margin-top: 10rpx; }
.mall-checkout-address--selected { border-color: #9dc5ff; background: #edf2ff; }
.mall-check { width: 36rpx; height: 36rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 2rpx solid #bdc7bf; border-radius: 50%; color: #fff; font-size: 22rpx; box-sizing: border-box; }
.mall-check--selected { border-color: var(--blue); background: var(--blue); }
.mall-checkout-address__body { min-width: 0; flex: 1; }
.mall-checkout-address__top { display: flex; align-items: center; gap: 12rpx; color: #34443b; font-size: 27rpx; font-weight: 650; }
.mall-checkout-address__top text:nth-child(2) { color: #6c7971; font-size: 24rpx; font-weight: 400; }
.mall-address-default { margin-left: auto; color: #1677ff; font-size: 24rpx; }
.mall-checkout-address__region { display: block; margin-top: 9rpx; color: #58675e; font-size: 25rpx; }
.mall-checkout-address__mask { display: block; margin-top: 5rpx; color: #737e77; font-size: 24rpx; }
.mall-address-missing { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; color: #69766e; font-size: 24rpx; }
.mall-secondary-button { height: 60rpx; flex: none; padding: 0 20rpx; border: 1rpx solid #c9d9f5; border-radius: 999rpx; color: #1677ff; background: #fff; font-size: 24rpx; line-height: 58rpx; }
.mall-checkout-product { display: flex; align-items: center; gap: 14rpx; min-height: 90rpx; padding: 8rpx 0; }
.mall-checkout-product + .mall-checkout-product { border-top: 1rpx solid #eff0ec; }
.mall-checkout-product__image { width: 70rpx; height: 70rpx; flex: none; border-radius: 12rpx; background: #eef2ed; }
.mall-checkout-product__mark { width: 70rpx; height: 70rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: #eef2ed; }
.mall-checkout-product__body { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 7rpx; color: #35443c; font-size: 27rpx; }
.mall-muted { color: #737e77; font-size: 24rpx; font-weight: 400; }
.mall-checkout-product__price { display: flex; flex-direction: column; align-items: flex-end; gap: 7rpx; color: #bd563f; font-size: 24rpx; font-weight: 650; }
.mall-checkout-product--placeholder { color: #737e77; font-size: 24rpx; }
.mall-checkout-costs { display: flex; flex-direction: column; gap: 18rpx; }
.mall-checkout-costs > view { display: flex; justify-content: space-between; color: #78847c; font-size: 26rpx; }
.mall-checkout-costs .mall-checkout-costs__total { padding-top: 16rpx; border-top: 1rpx solid #eff0ec; color: #394940; font-size: 28rpx; font-weight: 700; }
.mall-checkout-costs__total text:last-child { color: #bd563f; font-size: 31rpx; }
.mall-note-field { display: flex; flex-direction: column; gap: 12rpx; }
.mall-note-field__label { color: #394940; font-size: 26rpx; }
.mall-note-field__input { width: 100%; min-height: 100rpx; box-sizing: border-box; padding: 14rpx 18rpx; border: 1rpx solid #e8ebe6; border-radius: 12rpx; color: #4d5b53; background: #fbfcfa; font-size: 24rpx; line-height: 1.5; }
.mall-option-row { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #eff0ec; color: #46564d; font-size: 26rpx; }
.mall-option-row > view:last-child { display: flex; flex-direction: column; gap: 5rpx; }
.mall-option-hint { color: #737e77; font-size: 24rpx; line-height: 1.5; }
.mall-inline-message { display: block; margin: 8rpx 4rpx 18rpx; color: #a24e3d; font-size: 24rpx; line-height: 1.5; }
.mall-flow-state { min-height: 55vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; padding: 40rpx; color: #7a8980; font-size: 26rpx; text-align: center; }
.mall-flow-state__title { color: #34443b; font-size: 32rpx; font-weight: 700; }
.mall-primary-button { min-width: 210rpx; height: 82rpx; padding: 0 34rpx; border: 0; border-radius: 999rpx; color: #fff; background: var(--blue); font-size: 30rpx; font-weight: 650; line-height: 82rpx; }
.mall-primary-button[disabled] { background: #b6c0ba; }
.mall-checkout-footer { flex: none; padding: 12rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e7e8e2; background: #fff; }
.mall-checkout-footer__summary { display: flex; align-items: baseline; gap: 10rpx; color: #68766e; font-size: 24rpx; }
.mall-price { color: #bd563f; font-size: 32rpx; font-weight: 750; }
.mall-checkout-submit { display: block; width: 100%; margin-top: 12rpx; }
.mall-checkout-footer__closed { display: block; margin-top: 8rpx; color: #a24e3d; font-size: 24rpx; text-align: center; }
