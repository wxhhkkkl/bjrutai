<view class="mall-flow-page">
  <flow-navigation title="确认订单" bind:back="goBack" />
  <scroll-view class="mall-flow-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:if="{{state === 'loading'}}" class="mall-flow-state"><van-icon name="replay" size="30px" color="#1677FF" /><text>正在核对结算信息</text></view>
    <view wx:elif="{{state === 'empty'}}" class="mall-flow-state"><text class="mall-flow-state__title">没有待结算商品</text><text>{{stateMessage}}</text><button class="mall-primary-button tap-target" bindtap="backToCart" hover-class="tap-feedback">返回购物车</button></view>
    <view wx:elif="{{state === 'recoverable-error'}}" class="mall-flow-state"><text class="mall-flow-state__title">结算信息暂时不可用</text><text>{{stateMessage}}</text><button class="mall-primary-button tap-target" bindtap="retry" hover-class="tap-feedback">重新加载</button></view>
    <view wx:elif="{{state === 'success'}}" class="mall-checkout-content">
      <view wx:if="{{draft.deliveryMethod !== 'virtual'}}" class="mall-checkout-section">
        <view class="mall-section-heading"><text>收货地址</text><text class="mall-link tap-target" bindtap="openAddresses" hover-class="tap-feedback">{{addresses.length ? '选择地址' : '添加地址'}}</text></view>
        <view wx:if="{{addresses.length}}" class="mall-checkout-address-list">
          <view wx:for="{{addresses}}" wx:key="id" class="mall-checkout-address {{selectedAddressId === item.id ? 'mall-checkout-address--selected' : ''}} tap-target" bindtap="chooseAddress" data-id="{{item.id}}" hover-class="tap-feedback">
            <view class="mall-check {{selectedAddressId === item.id ? 'mall-check--selected' : ''}}"><text wx:if="{{selectedAddressId === item.id}}">✓</text></view>
            <view class="mall-checkout-address__body"><view class="mall-checkout-address__top"><text>{{item.recipientName}}</text><text>{{item.phoneMasked}}</text><text wx:if="{{item.isDefault}}" class="mall-address-default">默认</text></view><text class="mall-checkout-address__region">{{item.regionText}}</text><text class="mall-checkout-address__mask">{{item.addressMasked}}</text></view>
          </view>
        </view>
        <view wx:else class="mall-address-missing"><text>请先添加收货地址，服务器会按所选地区核验配送</text><button class="mall-secondary-button tap-target" bindtap="openAddresses" hover-class="tap-feedback">新增地址</button></view>
      </view>

      <view wx:else class="mall-checkout-section mall-virtual-fulfillment">
        <view class="mall-section-heading"><text>交付方式</text></view>
        <text>虚拟商品无需收货地址和运费，付款后由商家手工交付，交付内容可在订单详情查看。</text>
      </view>

      <view class="mall-checkout-section">
        <view class="mall-section-heading"><text>商品清单</text><text class="mall-muted">{{draft.items.length}} 种</text></view>
        <view wx:for="{{quote.items}}" wx:key="skuId" class="mall-checkout-product">
          <image
            wx:if="{{item.coverUrl && !item.coverImageFailed}}"
            class="mall-checkout-product__image"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            lazy-load
            data-sku-id="{{item.skuId}}"
            binderror="onQuoteImageError"
          />
          <view wx:else class="mall-checkout-product__mark">
            <van-icon name="shop-o" size="24px" color="#7B9187" />
          </view>
          <view class="mall-checkout-product__body">
            <text>{{item.productName}}</text>
            <text wx:if="{{item.optionsText}}" class="mall-muted">{{item.optionsText}}</text>
          </view>
          <view class="mall-checkout-product__price">
            <text>¥{{item.unitPriceText}}</text>
            <text class="mall-muted">× {{item.quantity}}</text>
          </view>
        </view>
        <view wx:if="{{!quote || !quote.items.length}}" class="mall-checkout-product mall-checkout-product--placeholder"><text>商品与数量将按服务器报价核对</text></view>
      </view>

      <view class="mall-checkout-section mall-checkout-costs" wx:if="{{quote}}">
        <view><text>商品金额</text><text>¥{{quote.goodsAmountText}}</text></view>
        <view wx:if="{{quote.deliveryMethod !== 'virtual'}}"><text>运费</text><text>{{quote.freightText}}</text></view>
        <view class="mall-checkout-costs__total"><text>应付金额</text><text>¥{{quote.payableAmountText}}</text></view>
      </view>

      <view class="mall-checkout-section mall-checkout-options">
        <view class="mall-note-field">
          <text class="mall-note-field__label">订单备注</text>
          <textarea class="mall-note-field__input" value="{{buyerNote}}" bindinput="onNoteInput" maxlength="200" auto-height="{{true}}" placeholder="选填，最多200字" adjust-position="true" cursor-spacing="80" />
        </view>
        <view class="mall-option-row tap-target" bindtap="toggleInvoiceIntent" hover-class="tap-feedback"><view class="mall-check {{invoiceIntent ? 'mall-check--selected' : ''}}"><text wx:if="{{invoiceIntent}}">✓</text></view><view><text>付款后需要交易发票</text><text class="mall-option-hint">这里记录开票意向；付款后再提交发票资料</text></view></view>
      </view>
      <text wx:if="{{quoteMessage}}" class="mall-inline-message">{{quoteMessage}}</text>
    </view>
  </scroll-view>

  <view wx:if="{{state === 'success'}}" class="mall-checkout-footer">
    <view class="mall-checkout-footer__summary"><text>应付</text><text class="mall-price">¥{{quote ? quote.payableAmountText : '--'}}</text></view>
    <button class="mall-primary-button mall-checkout-submit tap-target" bindtap="submitOrder" loading="{{submitting}}" disabled="{{submitting || (!pendingSubmission && (!purchaseAvailable || !quote))}}" hover-class="tap-feedback">{{pendingSubmission ? '继续确认订单' : '确认并提交订单'}}</button>
    <text wx:if="{{!purchaseAvailable}}" class="mall-checkout-footer__closed">当前商城未开放购买</text>
  </view>
</view>
