<flow-navigation title="确认登陆小程序" show-back="{{false}}" bind:back="handleBack" />

<view class="scan-page {{state === 'ready' ? 'scan-page--ready' : ''}}">
  <view wx:if="{{state === 'loading'}}" class="scan-state">正在验证客户绑定码…</view>

  <view wx:elif="{{state === 'invalid'}}" class="scan-card scan-card--state">
    <van-icon name="warning-o" size="48px" color="#e65d4f" />
    <text class="scan-title">暂时无法绑定</text>
    <text class="scan-description">{{stateMessage}}</text>
  </view>

  <view wx:elif="{{state === 'success'}}" class="scan-card scan-card--state">
    <van-icon name="passed" size="54px" color="#20af6b" />
    <text class="scan-title">绑定成功</text>
    <text class="scan-description">您已绑定至{{result.distributorName}}，后续由该客户顾问为您提供服务。</text>
    <text class="scan-meta">{{result.organizationName}} · {{result.phone}}</text>
  </view>

  <block wx:elif="{{state === 'ready'}}">
    <image
      class="scan-welcome"
      src="/assets/images/patient-binding-welcome-v1.jpg"
      mode="widthFix"
      aria-label="欢迎来到儒泰医联"
    />
    <view class="scan-actions">
      <text class="scan-guidance">点击下方按钮，按微信提示授权手机号。</text>
      <button
        class="scan-submit"
        open-type="getPhoneNumber"
        bindgetphonenumber="submit"
        loading="{{submitting}}"
        disabled="{{submitting}}"
      >确认登陆小程序</button>
    </view>
  </block>
</view>

<view wx:if="{{bindingErrorMessage}}" class="scan-binding-notice">
  <text class="scan-binding-notice-message">{{bindingErrorMessage}}</text>
  <text class="scan-binding-notice-hint">3 秒后自动返回首页</text>
</view>
