<flow-navigation title="确认客户绑定" bind:back="handleBack" />

<view class="scan-page">
  <view wx:if="{{state === 'loading'}}" class="scan-state">正在验证客户绑定码…</view>

  <view wx:elif="{{state === 'invalid'}}" class="scan-card scan-card--state">
    <van-icon name="warning-o" size="48px" color="#e65d4f" />
    <text class="scan-title">暂时无法绑定</text>
    <text class="scan-description">{{stateMessage}}</text>
  </view>

  <view wx:elif="{{state === 'success'}}" class="scan-card scan-card--state">
    <van-icon name="passed" size="54px" color="#20af6b" />
    <text class="scan-title">绑定成功</text>
    <text class="scan-description">您已绑定至{{result.distributorName}}，后续由该客户顾问为您提供服务。</text>
    <text class="scan-meta">{{result.organizationName}} · {{result.phone}}</text>
  </view>

  <block wx:else>
    <view class="scan-consent tap-target" bindtap="toggleConsent" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">
      <view class="scan-checkbox {{consentConfirmed ? 'scan-checkbox--checked' : ''}}">
        <van-icon wx:if="{{consentConfirmed}}" name="success" size="14px" color="#ffffff" />
      </view>
      <text>我同意将手机号用于客户归属与后续服务</text>
    </view>
    <button wx:if="{{consentConfirmed}}" class="scan-submit" open-type="getPhoneNumber" bindgetphonenumber="submit" loading="{{submitting}}" disabled="{{submitting}}">授权手机号并确认绑定</button>
    <button wx:else class="scan-submit tap-target" bindtap="requestPhoneAuthorization" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80" loading="{{submitting}}" disabled="{{submitting}}">授权手机号并确认绑定</button>
  </block>
</view>
