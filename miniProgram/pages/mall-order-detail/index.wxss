@import "../../styles/interactions.wxss";

page { background: #f4f3ee; }
.mall-flow-page { height: 100vh; display: flex; flex-direction: column; padding-bottom: env(safe-area-inset-bottom); background: #f4f3ee; box-sizing: border-box; }
.mall-flow-page > flow-navigation { flex: none; }
.mall-flow-scroll { min-height: 0; flex: 1; }
.mall-order-status-card { display: flex; align-items: center; gap: 16rpx; margin: 20rpx 22rpx 14rpx; padding: 24rpx 22rpx; border: 1rpx solid #e6eae3; border-radius: 18rpx; background: #fff; }
.mall-order-status-card__icon { width: 76rpx; height: 76rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eaf0e9; }
.mall-order-status-card__copy { display: flex; flex-direction: column; gap: 8rpx; }
.mall-order-status-card__title { color: #2d4237; font-size: 29rpx; font-weight: 700; }
.mall-order-status-card__hint { color: #89948d; font-size: 21rpx; line-height: 1.4; }
.mall-detail-card { margin: 0 22rpx 14rpx; padding: 20rpx; border: 1rpx solid #e7e9e2; border-radius: 18rpx; background: #fff; }
.mall-detail-card__heading { display: flex; align-items: center; gap: 10rpx; margin-bottom: 16rpx; color: #35443b; font-size: 25rpx; font-weight: 700; }
.mall-heading-arrow { margin-left: auto; }
.mall-address-detail__person { display: flex; align-items: center; justify-content: space-between; color: #334139; font-size: 24rpx; font-weight: 600; }
.mall-address-detail__region { display: block; margin-top: 12rpx; color: #53655b; font-size: 22rpx; }
.mall-address-detail__masked { display: block; margin-top: 8rpx; color: #929b95; font-size: 21rpx; }
.mall-detail-item { display: flex; align-items: center; gap: 14rpx; padding: 12rpx 0; border-top: 1rpx solid #eff0eb; }
.mall-detail-item:first-of-type { border-top: 0; }
.mall-detail-item__image { width: 88rpx; height: 88rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: #f0f3ef; }
.mall-detail-item__copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 9rpx; }
.mall-detail-item__name { overflow: hidden; color: #334139; font-size: 23rpx; font-weight: 650; white-space: nowrap; text-overflow: ellipsis; }
.mall-detail-item__options { color: #929b95; font-size: 20rpx; }
.mall-detail-item__price { color: #bd563f; font-size: 23rpx; font-weight: 700; }
.mall-shipment-card__line { display: block; color: #53655a; font-size: 22rpx; }
.mall-shipment-card__status { display: block; margin-top: 10rpx; color: #27645b; font-size: 22rpx; font-weight: 600; }
.mall-shipment-card__hint { display: block; margin-top: 8rpx; color: #929b95; font-size: 19rpx; }
.mall-amount-row { display: flex; align-items: center; justify-content: space-between; min-height: 48rpx; color: #7b867f; font-size: 21rpx; }
.mall-amount-row--total { margin-top: 8rpx; padding-top: 10rpx; border-top: 1rpx solid #eff0eb; color: #35443b; font-size: 23rpx; font-weight: 650; }
.mall-amount-row--total text:last-child { color: #bd563f; font-size: 27rpx; }
.mall-invoice-entry-card__status { margin-left: auto; color: #89948d; font-size: 19rpx; font-weight: 400; }
.mall-invoice-entry-card__bottom { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; color: #929b95; font-size: 19rpx; line-height: 1.45; }
.mall-invoice-entry-card__bottom text { flex: 1; }
.mall-invoice-entry-card__button { flex: none; height: 62rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid #d8e2da; border-radius: 999rpx; color: #27645b; background: #f3f7f2; font-size: 19rpx; line-height: 60rpx; }
.mall-aftersale-link { min-height: 72rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 4rpx; border-top: 1rpx solid #eff0eb; color: #27645b; font-size: 22rpx; }
.mall-timeline-row { position: relative; display: flex; gap: 14rpx; padding: 6rpx 0 13rpx; }
.mall-timeline-dot { width: 13rpx; height: 13rpx; flex: none; margin-top: 7rpx; border-radius: 50%; background: #6b8a78; }
.mall-timeline-copy { flex: 1; display: flex; justify-content: space-between; gap: 10rpx; color: #55645b; font-size: 21rpx; }
.mall-timeline-copy text:last-child { color: #9aa29c; font-size: 19rpx; }
.mall-order-number { display: block; margin-top: 10rpx; color: #929b95; font-size: 19rpx; }
.mall-inline-message { display: block; margin-top: 12rpx; color: #a24e3d; font-size: 21rpx; }
.mall-order-actions { flex: none; display: flex; justify-content: flex-end; gap: 12rpx; padding: 14rpx 22rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8e9e4; background: #fff; }
.mall-primary-button, .mall-secondary-button { min-width: 210rpx; height: 78rpx; margin: 0; padding: 0 28rpx; border: 0; border-radius: 999rpx; font-size: 24rpx; line-height: 78rpx; }
.mall-primary-button { color: #fff; background: #27645b; }
.mall-secondary-button { color: #27645b; background: #edf2ed; }
.mall-flow-state { min-height: 55vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; padding: 40rpx; color: #7a8980; font-size: 24rpx; text-align: center; }
.mall-flow-state__title { color: #34443b; font-size: 30rpx; font-weight: 700; }
