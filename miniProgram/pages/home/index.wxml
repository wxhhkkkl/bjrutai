<scroll-view class="home-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <app-header title="儒泰医联" show-logo="{{true}}" />
    <view class="screen tab-screen">
        <view wx:if="{{bannerState === 'success'}}" class="home-banners">
            <swiper class="home-banners__swiper" autoplay="{{bannerItems.length > 1}}" circular="{{bannerItems.length > 1}}" interval="4500" duration="380" indicator-dots="{{bannerItems.length > 1}}" indicator-color="rgba(255,255,255,.45)" indicator-active-color="#ffffff">
                <swiper-item wx:for="{{bannerItems}}" wx:key="bannerId">
                    <view class="home-banners__item tap-target" data-id="{{item.bannerId}}" bindtap="openBanner" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">
                        <image class="home-banners__image" src="{{item.imageUrl}}" mode="aspectFill" binderror="hideBrokenBanner" data-id="{{item.bannerId}}" />
                        <view wx:if="{{item.title}}" class="home-banners__shade">
                            <text class="home-banners__title">{{item.title}}</text>
                        </view>
                    </view>
                </swiper-item>
            </swiper>
        </view>

        <view class="section-heading section-heading--with-more about-heading">
            <text class="section-title">关于儒泰</text>
            <text class="section-more tap-target" data-category="关于儒泰" bindtap="openArticleCategory" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">更多 ›</text>
        </view>
        <view wx:if="{{aboutState === 'success'}}" class="about-card about-card--link tap-target" data-id="{{aboutArticle.articleId}}" bindtap="openArticle" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">
            <view class="about-card__cover">
                <image class="about-card__cover-image" src="{{aboutArticle.coverImageUrl || '/assets/images/about-lutai-enterprise-cover-v1.png'}}" mode="aspectFill" />
            </view>
            <view class="about-card__body">
                <view class="about-card__copy">
                    <text class="about-card__title">{{aboutArticle.title}}</text>
                    <text class="about-card__description">{{aboutArticle.summary || '关于儒泰的健康服务资讯'}}</text>
                </view>
                <view class="about-card__enter">了解更多 <text>›</text></view>
            </view>
        </view>
        <view wx:elif="{{aboutState === 'empty'}}" class="about-empty">暂无“关于儒泰”分类文章</view>
        <view wx:elif="{{aboutState === 'recoverable-error'}}" class="about-empty about-empty--error">关于儒泰文章加载失败，请稍后重试</view>

        <view class="section-heading section-heading--with-more wellness-heading">
            <text class="section-title tap-target" data-category="心脑维养" bindtap="openArticleCategory" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">心脑维养</text>
            <text class="section-more tap-target" data-category="心脑维养" bindtap="openArticleCategory" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">更多 ›</text>
        </view>
        <view wx:if="{{wellnessState === 'success'}}" class="wellness-feature wellness-feature--link tap-target" data-id="{{wellnessArticle.articleId}}" bindtap="openArticle" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">
            <image wx:if="{{wellnessArticle.coverImageUrl}}" class="wellness-feature__cover" src="{{wellnessArticle.coverImageUrl}}" mode="aspectFill" />
            <view wx:if="{{wellnessArticle.coverImageUrl}}" class="wellness-feature__shade"></view>
            <view wx:if="{{!wellnessArticle.coverImageUrl}}" class="wellness-feature__orb wellness-feature__orb--one"></view>
            <view wx:if="{{!wellnessArticle.coverImageUrl}}" class="wellness-feature__orb wellness-feature__orb--two"></view>
            <view class="wellness-feature__copy">
                <text class="wellness-feature__eyebrow">心脑维养</text>
                <text class="wellness-feature__title">{{wellnessArticle.title}}</text>
                <text class="wellness-feature__description">{{wellnessArticle.summary || '关注心脑健康相关资讯，了解日常健康知识。'}}</text>
            </view>
        </view>
        <view wx:elif="{{wellnessState === 'empty'}}" class="wellness-empty">暂无“心脑维养”分类文章</view>
        <view wx:elif="{{wellnessState === 'recoverable-error'}}" class="wellness-empty wellness-empty--error">心脑维养文章加载失败，请稍后重试</view>
        <view class="article-heading">
            <view class="section-heading section-heading--compact">
                <text class="section-title">文章资讯</text>
            </view>
            <view class="section-more tap-target" data-id="article-list" bindtap="action" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">查看全部 ›</view>
        </view>
        <view wx:if="{{articleState === 'loading'}}" class="home-articles__state">资讯加载中…</view>
        <view wx:elif="{{articleState === 'empty'}}" class="home-articles__state">暂无文章资讯，可稍后查看</view>
        <view wx:elif="{{articleState === 'recoverable-error'}}" class="home-articles__state home-articles__state--error">
            <text>{{articleStateMessage}}</text>
            <button class="home-articles__retry tap-target" bindtap="retryArticles" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">重试</button>
        </view>
        <view wx:else class="home-article-list">
            <view wx:for="{{articleItems}}" wx:key="articleId" class="home-article-item tap-target" data-id="{{item.articleId}}" bindtap="openArticle" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">
                <image wx:if="{{item.coverImageUrl}}" class="home-article-item__cover" src="{{item.coverImageUrl}}" mode="aspectFill" />
                <view wx:else class="home-article-item__placeholder">文</view>
                <view class="home-article-item__copy">
                    <text class="home-article-item__title">{{item.title}}</text>
                    <text wx:if="{{item.summary}}" class="home-article-item__summary">{{item.summary}}</text>
                    <text class="home-article-item__meta">{{item.category || item.publishedAtDisplay || '文章资讯'}}</text>
                </view>
                <text class="home-article-item__arrow">›</text>
            </view>
        </view>

    </view>
</scroll-view>
