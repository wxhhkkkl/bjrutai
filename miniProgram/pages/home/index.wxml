<scroll-view class="home-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
  <app-header title="儒泰医联" show-logo="{{true}}" />

  <view class="home-page">
    <view class="home-hero">
      <view class="home-hero__orb home-hero__orb--large"></view>
      <view class="home-hero__orb home-hero__orb--small"></view>

      <view class="home-hero__brand">
        <view class="home-hero__brand-mark">
          <image src="/assets/images/home-brand-icon-v1.png" mode="aspectFill" />
        </view>
        <text class="home-hero__brand-name">RUTAI MEDICAL ALLIANCE</text>
      </view>

      <view class="home-hero__copy">
        <text class="home-hero__title">欢迎来到<text>儒泰医联</text></text>
        <text class="home-hero__description">以专业与温度，陪伴每一次健康选择</text>
      </view>

      <view wx:if="{{bannerState === 'success'}}" class="home-banners">
        <swiper class="home-banners__swiper" autoplay="{{bannerItems.length > 1}}" circular="{{bannerItems.length > 1}}" interval="4500" duration="380" indicator-dots="{{bannerItems.length > 1}}" indicator-color="rgba(255,255,255,.42)" indicator-active-color="#ffffff">
          <swiper-item wx:for="{{bannerItems}}" wx:key="bannerId">
            <view class="home-banners__item tap-target" data-id="{{item.bannerId}}" bindtap="openBanner" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">
              <image class="home-banners__image" src="{{item.imageUrl}}" mode="aspectFill" binderror="hideBrokenBanner" data-id="{{item.bannerId}}" />
              <view class="home-banners__veil"></view>
              <view class="home-banners__copy">
                <text class="home-banners__kicker">健康生活</text>
                <text class="home-banners__title">{{item.title || '专业照护，安心同行'}}</text>
              </view>
            </view>
          </swiper-item>
        </swiper>
      </view>

      <view wx:else class="home-banners home-banners--fallback">
        <view class="home-banners__fallback-line"></view>
        <view class="home-banners__fallback-copy">
          <text>健康关怀，从日常开始</text>
          <text>专业照护 · 安心同行</text>
        </view>
      </view>

      <view class="home-hero__tags">
        <text>中医诊疗</text>
        <text>心脑健康</text>
        <text>健康科普</text>
      </view>
    </view>

    <view class="home-entry-grid">
      <view class="home-entry-card tap-target" data-category="关于儒泰" bindtap="openArticleCategory" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">
        <image class="home-entry__icon" src="/assets/images/home-about-icon-v1.png" mode="aspectFit" />
        <text class="home-entry__title">关于儒泰</text>
        <text class="home-entry__description">了解儒泰<br />医联</text>
      </view>

      <view class="home-entry-card tap-target" data-category="心脑维养" bindtap="openArticleCategory" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">
        <image class="home-entry__icon" src="/assets/images/home-wellness-icon-v1.png" mode="aspectFit" />
        <text class="home-entry__title">心脑维养</text>
        <text class="home-entry__description">日常养护<br />与监测</text>
      </view>

      <view class="home-entry-card tap-target" data-id="article-list" bindtap="action" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">
        <image class="home-entry__icon" src="/assets/images/home-article-icon-v1.png" mode="aspectFit" />
        <text class="home-entry__title">健康资讯</text>
        <text class="home-entry__description">科普文章<br />与知识</text>
      </view>
    </view>
  </view>
</scroll-view>
