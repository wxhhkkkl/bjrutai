page {
    height: 100%;
    overflow: hidden;
    background: #f7f9fc;
}

.home-scroll {
    height: 100vh;
    background: #f7f9fc;
}

.screen {
    min-height: auto;
    padding: 34rpx 40rpx calc(172rpx + constant(safe-area-inset-bottom));
    padding: 34rpx 40rpx calc(172rpx + env(safe-area-inset-bottom));
}

.home-banners {
    height: 270rpx;
    overflow: hidden;
    border-radius: 32rpx;
    background: #e8eef5;
    box-shadow: 0 16rpx 36rpx rgba(21, 69, 118, 0.11);
}

.home-banners__swiper,
.home-banners__item,
.home-banners__image { width: 100%; height: 100%; }

.home-banners__item { position: relative; overflow: hidden; }
.home-banners__image { display: block; }

.home-banners__shade {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    box-sizing: border-box;
    min-height: 94rpx;
    padding: 42rpx 32rpx 18rpx;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.58));
}

.home-banners__title {
    display: block;
    overflow: hidden;
    color: #fff;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 1.35;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.section-heading { display: flex; flex-direction: column; }
.about-heading { margin: 26rpx 4rpx 18rpx; }
.wellness-heading { margin: 28rpx 4rpx 20rpx; }

.section-title {
    color: #10223a;
    font-size: 42rpx;
    font-weight: 700;
    line-height: 1.2;
}

.about-card {
    overflow: hidden;
    background: #fff;
    border: 1rpx solid #e9edf2;
    border-radius: 28rpx;
    box-shadow: 0 16rpx 34rpx rgba(28, 65, 102, 0.1);
}

.about-card__cover {
    position: relative;
    height: 252rpx;
    overflow: hidden;
    background: #dfeaf0;
}

.about-card__cover-image { display: block; width: 100%; height: 100%; }

.about-card__cover-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(9, 45, 78, 0.52), rgba(14, 70, 96, 0.09) 68%, rgba(10, 48, 68, 0.08));
}

.about-card__cover-brand {
    position: absolute;
    top: 32rpx;
    left: 30rpx;
    display: flex;
    align-items: center;
    gap: 14rpx;
    color: #fff;
}

.about-card__cover-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52rpx;
    height: 52rpx;
    flex: none;
    font-size: 21rpx;
    font-weight: 700;
    letter-spacing: .5rpx;
    background: rgba(255, 255, 255, 0.22);
    border: 1rpx solid rgba(255, 255, 255, 0.48);
    border-radius: 17rpx;
    backdrop-filter: blur(8rpx);
}

.about-card__cover-name { font-size: 26rpx; font-weight: 600; letter-spacing: 2rpx; }

.about-card__cover-label {
    position: absolute;
    bottom: 29rpx;
    left: 30rpx;
    color: #fff;
    font-size: 25rpx;
    font-weight: 600;
    letter-spacing: 1rpx;
    line-height: 1.3;
    text-shadow: 0 2rpx 8rpx rgba(5, 36, 61, 0.35);
}

.about-card__body {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24rpx;
    min-height: 162rpx;
    padding: 26rpx 30rpx 28rpx;
    box-sizing: border-box;
}

.about-card__copy { min-width: 0; display: flex; flex: 1; flex-direction: column; gap: 8rpx; }
.about-card__title { color: #17293f; font-size: 32rpx; font-weight: 700; line-height: 1.3; }
.about-card__description { overflow: hidden; color: #6b7b90; font-size: 24rpx; line-height: 1.55; white-space: nowrap; text-overflow: ellipsis; }
.about-card__enter { flex: none; padding-bottom: 2rpx; color: #2578a2; font-size: 22rpx; font-weight: 600; white-space: nowrap; }
.about-card__enter text { margin-left: 4rpx; font-size: 34rpx; font-weight: 400; line-height: .6; vertical-align: -2rpx; }
.about-card--link:active { opacity: .92; }

.wellness-feature {
    position: relative;
    overflow: hidden;
    min-height: 270rpx;
    padding: 38rpx 34rpx;
    box-sizing: border-box;
    background: linear-gradient(135deg, #163d68, #216986);
    border-radius: 32rpx;
    box-shadow: 0 18rpx 34rpx rgba(23, 68, 103, 0.18);
}

.wellness-feature__orb { position: absolute; border-radius: 50%; background: rgba(141, 217, 202, 0.16); }
.wellness-feature__orb--one { top: -74rpx; right: -30rpx; width: 232rpx; height: 232rpx; }
.wellness-feature__orb--two { right: 120rpx; bottom: -120rpx; width: 250rpx; height: 250rpx; background: rgba(202, 236, 218, 0.1); }

.wellness-feature__copy {
    position: relative;
    z-index: 1;
    display: flex;
    width: 75%;
    flex-direction: column;
    align-items: flex-start;
    gap: 13rpx;
}

.wellness-feature__eyebrow { color: #a9e2d6; font-size: 22rpx; line-height: 1.35; }
.wellness-feature__title { color: #fff; font-size: 39rpx; font-weight: 700; line-height: 1.28; }
.wellness-feature__description { color: rgba(235, 248, 250, 0.82); font-size: 23rpx; line-height: 1.65; }

.wellness-grid { display: flex; gap: 16rpx; margin-top: 18rpx; }

.wellness-item {
    box-sizing: border-box;
    width: 33.333%;
    min-height: 194rpx;
    padding: 20rpx 14rpx;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 9rpx;
    background: #fff;
    border: 1rpx solid #e6edf0;
    border-radius: 22rpx;
}

.wellness-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50rpx;
    height: 50rpx;
    color: #2972ba;
    font-size: 24rpx;
    font-weight: 700;
    background: #eaf4ff;
    border-radius: 16rpx;
}

.wellness-item__icon--orange { color: #c8752e; background: #fff1e4; }
.wellness-item__icon--green { color: #2b8c78; background: #e7f7f1; }
.wellness-item__title { color: #1c2e43; font-size: 25rpx; font-weight: 700; line-height: 1.3; }
.wellness-item__description { color: #8190a1; font-size: 20rpx; line-height: 1.45; }

.wellness-link {
    min-height: 86rpx;
    margin-top: 18rpx;
    padding: 0 28rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #206d95;
    font-size: 27rpx;
    font-weight: 600;
    background: #e9f5f5;
    border-radius: 22rpx;
}

.wellness-link__arrow { font-size: 42rpx; font-weight: 400; line-height: 1; }

.article-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin: 24rpx 4rpx 18rpx;
}

.heading-link { padding: 12rpx 0 8rpx 24rpx; color: #2773b8; font-size: 26rpx; }

.home-article-list {
    overflow: hidden;
    background: #fff;
    border: 1rpx solid #e9edf2;
    border-radius: 28rpx;
    box-shadow: 0 12rpx 28rpx rgba(32, 61, 104, 0.06);
}

.home-article-item { min-height: 154rpx; padding: 22rpx 24rpx; display: flex; align-items: center; gap: 20rpx; }
.home-article-item:not(:last-child) { border-bottom: 1rpx solid #e8ebf0; }

.home-article-item__cover,
.home-article-item__placeholder { width: 116rpx; height: 92rpx; flex: none; border-radius: 16rpx; }
.home-article-item__cover { background: #edf2f8; }

.home-article-item__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #538eea;
    font-size: 38rpx;
    font-weight: 700;
    background: linear-gradient(145deg, #edf6ff, #e4ecff);
}

.home-article-item__copy { min-width: 0; display: flex; flex: 1; flex-direction: column; gap: 7rpx; }
.home-article-item__title,
.home-article-item__summary,
.home-article-item__meta { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.home-article-item__title { color: #17293f; font-size: 29rpx; font-weight: 650; line-height: 1.35; }
.home-article-item__summary { color: #687b91; font-size: 23rpx; line-height: 1.4; }
.home-article-item__meta { color: #929eab; font-size: 21rpx; line-height: 1.35; }
.home-article-item__arrow { flex: none; color: #8b95a6; font-size: 42rpx; line-height: 1; }

.home-articles__state {
    min-height: 126rpx;
    padding: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18rpx;
    box-sizing: border-box;
    color: #7d8795;
    font-size: 26rpx;
    line-height: 1.45;
    text-align: center;
    background: #fff;
    border: 1rpx solid #e9edf2;
    border-radius: 24rpx;
}

.home-articles__state--error { color: #9a6260; }
.home-articles__retry {
    height: 54rpx;
    margin: 0;
    padding: 0 22rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1677ff;
    font-size: 23rpx;
    background: #eaf3ff;
    border: 0;
    border-radius: 999rpx;
}
