page { height: 100%; overflow: hidden; background: #f4f7f7; }

.home-scroll { height: 100vh; background: #f4f7f7; }

.home-page {
  min-height: 100%;
  padding: 20rpx 24rpx calc(172rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 24rpx calc(172rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.home-hero {
  position: relative;
  padding: 46rpx 40rpx 20rpx;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #078f80 0%, #087567 52%, #05675d 100%);
  box-shadow: 0 22rpx 48rpx rgba(10, 105, 93, .2);
}

.home-hero__orb { position: absolute; border-radius: 50%; pointer-events: none; }
.home-hero__orb--large { top: -128rpx; right: -104rpx; width: 350rpx; height: 350rpx; background: rgba(111, 214, 191, .14); }
.home-hero__orb--small { top: 238rpx; right: 54rpx; width: 118rpx; height: 118rpx; background: rgba(111, 214, 191, .12); }

.home-hero__brand,
.home-hero__copy,
.home-banners,
.home-hero__tags { position: relative; z-index: 1; }

.home-hero__brand { display: flex; align-items: center; }

.home-hero__brand-mark {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 24rpx;
}

.home-hero__brand-mark image { display: block; width: 100%; height: 100%; }

.home-hero__brand-name {
  margin-left: 18rpx;
  color: rgba(225, 255, 249, .64);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.home-hero__copy { margin-top: 36rpx; }

.home-hero__title { display: block; color: #fff; font-size: 52rpx; font-weight: 700; letter-spacing: -2rpx; line-height: 1.18; }
.home-hero__title text { display: block; }
.home-hero__description { display: block; margin-top: 14rpx; color: rgba(232, 255, 250, .86); font-size: 25rpx; line-height: 1.5; }

.home-banners {
  height: 320rpx;
  margin-top: 34rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, .24);
  border-radius: 24rpx;
  background: rgba(5, 91, 82, .38);
}

.home-banners__swiper,
.home-banners__item,
.home-banners__image { width: 100%; height: 100%; }

.home-banners__item { position: relative; overflow: hidden; }
.home-banners__image { display: block; }

.home-banners__veil {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(90deg, rgba(3, 54, 48, .78) 0%, rgba(3, 54, 48, .28) 65%, rgba(3, 54, 48, .06) 100%);
}

.home-banners__copy { position: absolute; right: 26rpx; bottom: 32rpx; left: 26rpx; display: flex; flex-direction: column; }
.home-banners__kicker { color: rgba(233, 255, 250, .76); font-size: 20rpx; font-weight: 600; letter-spacing: 2rpx; line-height: 1.3; }

.home-banners__title {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.32;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home-banners--fallback { display: flex; padding: 30rpx; box-sizing: border-box; align-items: flex-end; background: linear-gradient(135deg, rgba(9, 129, 116, .8), rgba(5, 89, 81, .86)); }
.home-banners__fallback-line { position: absolute; right: 24rpx; bottom: 54rpx; left: 24rpx; height: 2rpx; background: rgba(231, 255, 249, .58); }

.home-banners__fallback-line::before,
.home-banners__fallback-line::after { position: absolute; top: -22rpx; width: 2rpx; height: 24rpx; content: ''; background: rgba(231, 255, 249, .58); }
.home-banners__fallback-line::before { left: 34%; transform: rotate(38deg); }
.home-banners__fallback-line::after { left: 36%; transform: rotate(-39deg); }

.home-banners__fallback-copy { display: flex; flex-direction: column; color: #fff; }
.home-banners__fallback-copy text:first-child { font-size: 31rpx; font-weight: 700; line-height: 1.35; }
.home-banners__fallback-copy text:last-child { margin-top: 8rpx; color: rgba(232, 255, 250, .78); font-size: 21rpx; line-height: 1.35; }

.home-hero__tags { display: flex; gap: 12rpx; margin-top: 22rpx; }
.home-hero__tags text { padding: 7rpx 16rpx; color: rgba(239, 255, 252, .86); font-size: 20rpx; line-height: 1.25; border: 1rpx solid rgba(255, 255, 255, .22); border-radius: 999rpx; background: rgba(255, 255, 255, .1); }

.home-entry-grid { display: flex; gap: 16rpx; margin-top: 24rpx; }

.home-entry-card {
  display: flex;
  min-width: 0;
  min-height: 312rpx;
  padding: 24rpx 16rpx 22rpx;
  box-sizing: border-box;
  flex: 1;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #e8efed;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(31, 72, 67, .07);
}

.home-entry__icon { display: block; width: 152rpx; height: 152rpx; flex: none; overflow: hidden; border-radius: 44rpx; }

.home-entry__title { display: block; margin-top: 18rpx; color: #193337; font-size: 27rpx; font-weight: 700; line-height: 1.3; white-space: nowrap; }
.home-entry__description { display: block; margin-top: 8rpx; color: #849397; font-size: 21rpx; line-height: 1.45; text-align: center; }
