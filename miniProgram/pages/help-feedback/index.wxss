page {
  background: #ffffff;
}

.help-feedback-page {
  min-height: 100vh;
  padding: 42rpx 32rpx calc(218rpx + constant(safe-area-inset-bottom));
  padding: 42rpx 32rpx calc(218rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 69%, #f8fbff 100%);
}

.help-title {
  display: block;
  color: #050505;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.help-description {
  display: block;
  margin-top: 16rpx;
  color: #69717d;
  font-size: 27rpx;
  line-height: 1.55;
}

.help-section-title {
  display: block;
  margin-top: 44rpx;
  color: #050505;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
}

.help-faq-card {
  margin-top: 22rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid #e7ebf1;
  border-radius: 26rpx;
  box-shadow: 0 9rpx 25rpx rgba(31, 61, 105, 0.06);
}

.help-faq-row {
  min-height: 108rpx;
  padding: 14rpx 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid #e2e6ec;
  border-radius: 6rpx;
}

.help-faq-row:last-child {
  border-bottom: 0;
}

.help-faq-row__icon {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: #edf5ff;
  border-radius: 11rpx;
}

.help-faq-row__title {
  min-width: 0;
  flex: 1;
  color: #101419;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.4;
}

.help-section-title--feedback {
  margin-top: 46rpx;
}

.help-field-label {
  display: block;
  margin-top: 32rpx;
  color: #11151a;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.35;
}

.help-type-list {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  border-radius: 15rpx;
}

.help-type-list--invalid {
  box-shadow: 0 0 0 2rpx #e63625;
}

.help-type-option {
  min-height: 76rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 25rpx;
  background: #ffffff;
  border: 2rpx solid #1677ff;
  border-radius: 18rpx;
}

.help-type-option--active {
  color: #ffffff;
  background: #1677ff;
  border-color: #1677ff;
}

.help-field-label--description {
  margin-top: 38rpx;
}

.help-textarea-wrap {
  position: relative;
  height: 220rpx;
  margin-top: 20rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #dfe4eb;
  border-radius: 22rpx;
}

.help-textarea-wrap--invalid {
  border-color: #e63625;
}

.help-textarea {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding: 26rpx 25rpx 52rpx;
  color: #101419;
  font-size: 25rpx;
  line-height: 1.55;
}

.help-textarea__placeholder {
  color: #9aa1ac;
}

.help-textarea__counter {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  color: #737b87;
  font-size: 22rpx;
}

.help-upload-heading {
  margin-top: 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.help-upload-heading .help-field-label {
  margin-top: 0;
}

.help-upload-heading__limit {
  color: #7a828e;
  font-size: 23rpx;
}

.help-upload-area {
  min-height: 136rpx;
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 14rpx;
}

.help-upload-area--invalid {
  box-shadow: 0 0 0 2rpx #e63625;
}

.help-upload-button,
.help-screenshot {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex: none;
  border-radius: 18rpx;
}

.help-upload-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
  color: #1677ff;
  font-size: 23rpx;
  background: #f7fbff;
  border: 2rpx dashed #8fc1ff;
}

.help-screenshot {
  overflow: visible;
  background: #eef5ff;
  border: 1rpx solid #c5dcff;
}

.help-screenshot__image {
  width: 100%;
  height: 100%;
  border-radius: 13rpx;
}

.help-screenshot__remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  z-index: 2;
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #30343b;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
}

.help-upload-hint {
  color: #7a828e;
  font-size: 22rpx;
  white-space: nowrap;
}

.help-submit-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  padding: 20rpx 32rpx calc(24rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #edf0f4;
}

.help-submit-button {
  width: 100%;
  height: 89rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  background: #050505;
  border-radius: 999rpx;
}

.help-submit-button--disabled {
  opacity: 0.72;
}

.help-submit-button > text {
  display: block;
  line-height: 1;
  white-space: nowrap;
}

.help-submit-bar__hint {
  display: block;
  margin-top: 14rpx;
  color: #8c939e;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}

@media (max-width: 350px) {
  .help-feedback-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .help-faq-card {
    padding-right: 17rpx;
    padding-left: 17rpx;
  }

  .help-type-list {
    gap: 11rpx;
  }

  .help-type-option {
    font-size: 23rpx;
  }

  .help-upload-area {
    gap: 10rpx;
  }

}
