<view class="mall-product-detail">
  <flow-navigation title="商品详情" bind:back="goBack" />

  <scroll-view class="mall-product-detail__scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <block wx:if="{{state === 'success'}}">
      <view class="mall-product-gallery">
        <swiper
          wx:if="{{images.length > 0}}"
          class="mall-product-gallery__swiper"
          indicator-dots="{{images.length > 1}}"
          indicator-color="rgba(22, 119, 255, 0.24)"
          indicator-active-color="#1677FF"
          circular="{{false}}"
        >
          <swiper-item wx:for="{{images}}" wx:key="*this">
            <image class="mall-product-gallery__image" src="{{item}}" mode="aspectFit" lazy-load="{{true}}" />
          </swiper-item>
        </swiper>
        <view wx:else class="mall-product-gallery__empty" aria-label="暂无商品图片">
          <van-icon name="photo-o" size="44px" color="#AEB8B2" />
        </view>
      </view>

      <view class="mall-product-detail__content">
        <view class="mall-product-summary">
          <view class="mall-product-summary__price-row">
            <view class="mall-product-summary__price-group">
              <view class="mall-product-summary__price">
                <text class="mall-product-summary__sale-label">销售价</text>
                <text class="mall-product-summary__currency">¥</text>
                <text>{{priceText}}</text>
              </view>
              <text wx:if="{{marketPriceText}}" class="mall-product-summary__market-price">市场价 ¥{{marketPriceText}}</text>
            </view>
            <text class="mall-product-summary__availability {{availability === 'available' ? 'mall-product-summary__availability--available' : ''}}">
              {{availabilityText}}
            </text>
          </view>
          <text class="mall-product-summary__name">{{product.name}}</text>
          <text wx:if="{{product.summary}}" class="mall-product-summary__subtitle">{{product.summary}}</text>
          <text wx:if="{{product.deliveryMethod === 'virtual' || product.productType === 'virtual'}}" class="mall-product-virtual-hint">虚拟商品 · 付款后由商家手工交付，无需填写收货地址</text>
        </view>

        <view wx:if="{{skus.length > 0}}" class="mall-product-section">
          <view class="mall-product-section__heading">
            <text>选择规格</text>
          </view>
          <view class="mall-product-skus">
            <view
              wx:for="{{skus}}"
              wx:key="id"
              class="mall-product-sku tap-target {{selectedSkuId === item.id ? 'mall-product-sku--selected' : ''}} {{item.availability === 'sold_out' ? 'mall-product-sku--soldout' : ''}}"
              bindtap="selectSku"
              data-id="{{item.id}}"
              hover-class="tap-feedback"
              hover-start-time="0"
              hover-stay-time="80"
              aria-role="button"
              aria-label="{{item.label}}，{{item.availabilityText}}，价格{{item.priceText}}元"
            >
              <view class="mall-product-sku__main">
                <text class="mall-product-sku__name">{{item.label}}</text>
                <text class="mall-product-sku__stock">{{item.availabilityText}}</text>
              </view>
              <view class="mall-product-sku__price-group">
                <view class="mall-product-sku__price">¥{{item.priceText}}</view>
                <text wx:if="{{item.marketPriceText}}" class="mall-product-sku__market-price">¥{{item.marketPriceText}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{product.description}}" class="mall-product-section mall-product-copy">
          <text class="mall-product-section__title">商品介绍</text>
          <rich-text wx:if="{{descriptionHtml}}" nodes="{{descriptionHtml}}" />
          <text wx:else class="mall-product-copy__text">{{product.description}}</text>
        </view>

        <view wx:if="{{product.instructions}}" class="mall-product-section mall-product-copy">
          <text class="mall-product-section__title">使用说明</text>
          <text class="mall-product-copy__text">{{product.instructions}}</text>
        </view>

        <view wx:if="{{product.supportsReturn === true || product.supportsReturn === false || product.returnInstructions}}" class="mall-product-section mall-product-copy">
          <text class="mall-product-section__title">配送与退货</text>
          <text wx:if="{{product.supportsReturn === true || product.supportsReturn === false}}" class="mall-product-copy__text">{{product.supportsReturn ? '支持退货' : '不支持退货'}}</text>
          <text wx:if="{{product.returnInstructions}}" class="mall-product-copy__text">{{product.returnInstructions}}</text>
        </view>

        <view class="mall-product-detail__footer-note">
          <van-icon name="shield-o" size="16px" color="#1677FF" />
          <text>商品价格与库存以当前页面显示为准</text>
        </view>
      </view>
    </block>

    <view wx:if="{{state !== 'success'}}" class="mall-product-detail-state">
      <van-icon
        name="{{state === 'loading' ? 'replay' : state === 'forbidden' ? 'lock' : state === 'empty' ? 'info-o' : 'warning-o'}}"
        class="{{state === 'loading' ? 'mall-loading-icon' : ''}}"
        size="34px"
        color="#87948C"
      />
      <text class="mall-product-detail-state__title">
        {{state === 'loading' ? '正在加载商品' : state === 'forbidden' ? '商品暂不可访问' : state === 'empty' ? '商品暂不可用' : '详情加载失败'}}
      </text>
      <text class="mall-product-detail-state__message">{{stateMessage}}</text>
      <button wx:if="{{state === 'recoverable-error'}}" class="mall-product-detail-state__action tap-target" bindtap="retry" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">重新加载</button>
      <button wx:elif="{{state === 'empty' || state === 'forbidden'}}" class="mall-product-detail-state__action tap-target" bindtap="backToMall" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">返回商城</button>
    </view>
  </scroll-view>
  <mall-floating-cart wx:if="{{state === 'success'}}" id="mall-floating-cart" />
  <view wx:if="{{state === 'success'}}" class="mall-product-footer">
    <text wx:if="{{purchaseMessage}}" class="mall-product-footer__message">{{purchaseMessage}}</text>
    <view class="mall-product-footer__actions">
      <button class="mall-product-footer__secondary tap-target" bindtap="addToCart" loading="{{purchaseBusy}}" disabled="{{availability !== 'available' || purchaseBusy}}" hover-class="tap-feedback">加入购物车</button>
      <button class="mall-product-footer__primary tap-target" bindtap="buyNow" loading="{{purchaseBusy}}" disabled="{{availability !== 'available' || purchaseBusy}}" hover-class="tap-feedback">立即购买</button>
    </view>
  </view>
</view>
