@import "../../styles/interactions.wxss";

page { background: #f4f3ee; }
.mall-flow-page { height: 100vh; display: flex; flex-direction: column; padding-bottom: env(safe-area-inset-bottom); background: #f4f3ee; box-sizing: border-box; }
.mall-flow-page > flow-navigation { flex: none; }
.mall-flow-scroll { min-height: 0; flex: 1; }
.mall-after-status { display: flex; align-items: center; gap: 16rpx; margin: 20rpx 22rpx 14rpx; padding: 24rpx 22rpx; border: 1rpx solid #e6eae3; border-radius: 18rpx; background: #fff; }
.mall-after-status__icon { width: 76rpx; height: 76rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eaf0e9; }
.mall-after-status__copy { display: flex; flex-direction: column; gap: 8rpx; }
.mall-after-status__title { color: #2d4237; font-size: 29rpx; font-weight: 700; }
.mall-after-status__hint { color: #89948d; font-size: 20rpx; }
.mall-aftersale-detail-card { margin: 0 22rpx 14rpx; padding: 21rpx; border: 1rpx solid #e7e9e2; border-radius: 18rpx; background: #fff; }
.mall-section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; color: #2c3b33; font-size: 25rpx; font-weight: 700; }
.mall-muted { color: #929b95; font-size: 19rpx; font-weight: 400; }
.mall-after-field { display: block; margin: 10rpx 0; color: #647168; font-size: 21rpx; line-height: 1.5; }
.mall-after-item, .mall-after-amount { min-height: 48rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; color: #76837b; font-size: 20rpx; }
.mall-after-amount { border-top: 1rpx solid #eff0eb; }
.mall-after-amount text:last-child { color: #45564b; font-weight: 650; }
.mall-after-note, .mall-return-instructions { display: block; margin-top: 12rpx; padding: 13rpx; border-radius: 12rpx; color: #66756c; background: #f6f7f3; font-size: 20rpx; line-height: 1.6; white-space: pre-wrap; }
.mall-financial-row { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; min-height: 78rpx; border-top: 1rpx solid #eff0eb; color: #526158; font-size: 21rpx; }
.mall-financial-row > view { display: flex; flex-direction: column; gap: 5rpx; }
.mall-financial-hint { color: #969f99; font-size: 17rpx; }
.mall-financial-value { flex: none; color: #27645b; font-size: 20rpx; font-weight: 650; }
.mall-financial-note { display: block; padding: 13rpx; border-radius: 12rpx; color: #8d6555; background: #fbf3ed; font-size: 19rpx; line-height: 1.5; }
.mall-aftersale-meta { display: flex; flex-direction: column; gap: 9rpx; color: #929b95; font-size: 18rpx; }
.mall-inline-message { color: #a24e3d; font-size: 20rpx; }
.mall-flow-state { min-height: 55vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; padding: 40rpx; color: #7a8980; font-size: 24rpx; text-align: center; }
.mall-flow-state__title { color: #34443b; font-size: 30rpx; font-weight: 700; }
.mall-primary-button, .mall-secondary-button { min-width: 170rpx; height: 74rpx; margin: 0; padding: 0 22rpx; border: 0; border-radius: 999rpx; font-size: 22rpx; line-height: 74rpx; }
.mall-primary-button { color: #fff; background: #27645b; }
.mall-secondary-button { color: #27645b; background: #edf2ed; }
.mall-aftersale-footer { flex: none; padding: 12rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e7e8e2; background: #fff; }
.mall-aftersale-footer--actions { display: flex; justify-content: flex-end; gap: 10rpx; }
