page {
  background: #ffffff;
}

.customer-screen {
  padding-top: 18rpx;
  padding-right: 28rpx;
  padding-left: 28rpx;
  background: #ffffff;
}

.customer-overview-card {
  min-height: 298rpx;
  padding: 29rpx 30rpx 24rpx;
  position: relative;
  overflow: hidden;
  border: 1rpx solid #d9e8ff;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f9fcff 0%, #ecf5ff 100%);
  box-shadow: 0 10rpx 24rpx rgba(37, 93, 171, 0.08);
}

.customer-overview-card::after {
  content: "";
  position: absolute;
  top: -64rpx;
  right: -48rpx;
  width: 210rpx;
  height: 210rpx;
  border: 28rpx solid rgba(133, 186, 255, 0.14);
  border-radius: 50%;
}

.customer-overview-card__header,
.customer-overview-metrics,
.customer-overview-analysis {
  position: relative;
  z-index: 1;
}

.customer-overview-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.customer-overview-card__title {
  display: block;
  color: #151b24;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.customer-overview-card__subtitle {
  display: block;
  margin-top: 12rpx;
  color: #778394;
  font-size: 22rpx;
  line-height: 1.3;
}

.customer-overview-card__visual {
  width: 92rpx;
  height: 92rpx;
  margin: -6rpx 7rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.56);
}

.customer-overview-metrics {
  margin-top: 25rpx;
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.customer-overview-metric {
  min-width: 0;
  display: flex;
  align-items: center;
  flex: 1;
  gap: 11rpx;
}

.customer-overview-metric__icon {
  width: 74rpx;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 18rpx;
}

.customer-overview-metric__icon--blue { background: #e4f1ff; }
.customer-overview-metric__icon--purple { background: #eee9ff; }
.customer-overview-metric__icon--orange { background: #fff0dd; }

.customer-overview-metric__copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 9rpx;
  color: #667182;
  font-size: 20rpx;
  line-height: 1;
  white-space: nowrap;
}

.customer-overview-metric__copy > text:last-child {
  color: #121820;
  font-size: 35rpx;
  font-weight: 700;
}

.customer-overview-analysis {
  margin-top: 17rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  color: #1677ff;
  font-size: 23rpx;
  line-height: 1;
}

.customer-search {
  height: 78rpx;
  margin-top: 34rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e1e5eb;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(27, 49, 83, 0.05);
}

.customer-search__input {
  min-width: 0;
  height: 100%;
  flex: 1;
  color: #20242b;
  font-size: 27rpx;
}

.customer-search__placeholder {
  color: #7d838e;
}

.filter-bar {
  min-height: 104rpx;
  margin-top: 22rpx;
  padding: 16rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e5e8ed;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(27, 49, 83, 0.05);
}

.filter-pills {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.filter-pill {
  min-width: 0;
  height: 58rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5f646d;
  font-size: 25rpx;
  line-height: 1;
  white-space: nowrap;
  border: 1rpx solid #e3e6eb;
  border-radius: 999rpx;
}

.filter-pill--active {
  color: #ffffff;
  background: #1677ff;
  border-color: #1677ff;
  box-shadow: 0 8rpx 18rpx rgba(22, 119, 255, 0.2);
}

.filter-button {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: #ffffff;
  border: 1rpx solid #e3e6eb;
  border-radius: 18rpx;
  box-shadow: 0 5rpx 12rpx rgba(27, 49, 83, 0.05);
}

.filter-glyph {
  width: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}

.filter-glyph > view {
  position: relative;
  width: 100%;
  height: 2rpx;
  background: #111820;
}

.filter-glyph > view::after {
  content: "";
  position: absolute;
  top: -4rpx;
  width: 8rpx;
  height: 8rpx;
  background: #ffffff;
  border: 2rpx solid #111820;
  border-radius: 50%;
}

.filter-glyph > view:nth-child(1)::after,
.filter-glyph > view:nth-child(3)::after {
  left: 7rpx;
}

.filter-glyph > view:nth-child(2)::after {
  right: 6rpx;
}

.customer-list-header {
  height: 98rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.customer-list-title {
  color: #050505;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.bind-customer {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #1677ff;
  font-size: 29rpx;
  font-weight: 500;
}

.bind-customer__icon {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1677ff;
  border-radius: 10rpx;
}

.customer-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.customer-card {
  min-height: 164rpx;
  padding: 24rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #ffffff;
  border: 1rpx solid #eef0f4;
  border-radius: 25rpx;
  box-shadow: 0 8rpx 22rpx rgba(27, 49, 83, 0.055);
}

.customer-avatar {
  width: 110rpx;
  height: 116rpx;
  flex: none;
  border-radius: 22rpx;
}

.customer-main {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.customer-name {
  overflow: hidden;
  color: #080808;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.15;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.customer-meta,
.customer-note {
  overflow: hidden;
  color: #666c76;
  font-size: 24rpx;
  line-height: 1.2;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.customer-status {
  min-width: 92rpx;
  height: 54rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: #ffffff;
  font-size: 24rpx;
  line-height: 1;
  border: 2rpx solid currentColor;
  border-radius: 18rpx;
}

.customer-status--blue {
  color: #1677ff;
}

.customer-status--orange {
  color: #f27a13;
}

.customer-status--green {
  color: #18a33a;
}

.customer-arrow {
  flex: none;
}

.customer-empty {
  padding: 80rpx 0;
  color: #8b919b;
  font-size: 28rpx;
  text-align: center;
}

@media (max-width: 340px) {
  .filter-pill {
    padding: 0 16rpx;
    font-size: 23rpx;
  }

  .customer-card {
    gap: 14rpx;
    padding-right: 16rpx;
    padding-left: 16rpx;
  }

  .customer-avatar {
    width: 100rpx;
    height: 106rpx;
  }
}
