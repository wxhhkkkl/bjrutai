<app-header title="客户" />

<view class="customer-screen tab-screen">
    <view class="customer-overview-card">
        <view class="customer-overview-card__header">
            <view>
                <text class="customer-overview-card__title">客户概览</text>
                <text class="customer-overview-card__subtitle">持续服务，让每一位客户都被看见</text>
            </view>
            <view class="customer-overview-card__visual">
                <van-icon name="friends-o" size="52rpx" color="#5c9dff" />
            </view>
        </view>
        <view class="customer-overview-metrics">
            <view class="customer-overview-metric">
                <view class="customer-overview-metric__icon customer-overview-metric__icon--blue">
                    <van-icon name="friends-o" size="38rpx" color="#1677ff" />
                </view>
                <view class="customer-overview-metric__copy">
                    <text>已绑定</text>
                    <text>{{overview.bound}}</text>
                </view>
            </view>
            <view class="customer-overview-metric">
                <view class="customer-overview-metric__icon customer-overview-metric__icon--purple">
                    <van-icon name="clock-o" size="38rpx" color="#5137ba" />
                </view>
                <view class="customer-overview-metric__copy">
                    <text>待匹配</text>
                    <text>{{overview.matching}}</text>
                </view>
            </view>
            <view class="customer-overview-metric">
                <view class="customer-overview-metric__icon customer-overview-metric__icon--orange">
                    <van-icon name="like-o" size="38rpx" color="#ec8400" />
                </view>
                <view class="customer-overview-metric__copy">
                    <text>待跟进</text>
                    <text>{{overview.followup}}</text>
                </view>
            </view>
        </view>
        <view class="customer-overview-analysis tap-target" bindtap="openAnalysis" hover-class="tap-feedback"
            hover-start-time="0" hover-stay-time="80" aria-role="button" aria-label="查看客户分析">
            查看客户分析 <van-icon name="arrow" size="25rpx" color="#1677ff" />
        </view>
    </view>

    <page-state state="{{state}}" bind:retry="retry" />

    <block wx:if="{{state === 'success'}}">
        <view class="customer-search">
            <van-icon name="search" size="22px" color="#747b88" />
            <input class="customer-search__input" value="{{keyword}}" placeholder="搜索姓名、手机号或身份证号"
                placeholder-class="customer-search__placeholder" confirm-type="search" bindinput="onSearch" />
        </view>

        <view class="filter-bar">
            <view class="filter-pills">
                <view wx:for="{{filters}}" wx:key="id"
                    class="filter-pill tap-target {{selectedFilter === item.id ? 'filter-pill--active' : ''}}"
                    data-id="{{item.id}}" bindtap="selectFilter" hover-class="tap-feedback" hover-start-time="0"
                    hover-stay-time="80">
                    {{item.label}} {{item.count}}
                </view>
            </view>
            <view class="filter-button tap-target" bindtap="openSort" hover-class="tap-feedback" hover-start-time="0"
                hover-stay-time="80" aria-role="button" aria-label="客户排序">
                <van-icon name="bars" />
            </view>
        </view>

        <view class="customer-list-header">
            <text class="customer-list-title">客户列表</text>
            <view class="bind-customer tap-target" bindtap="bindCustomer" hover-class="tap-feedback"
                hover-start-time="0" hover-stay-time="80" aria-role="button" aria-label="绑定客户">
                <view class="bind-customer__icon">
                    <van-icon name="plus" size="20px" color="#ffffff" />
                </view>
                <text>绑定客户</text>
            </view>
        </view>

        <view class="customer-list">
            <view wx:for="{{visibleList}}" wx:key="id" class="customer-card tap-target" data-id="{{item.id}}"
                bindtap="openCustomer" hover-class="tap-feedback" hover-start-time="0" hover-stay-time="80">
                <image class="customer-avatar" src="{{item.avatar}}" mode="aspectFill" />
                <view class="customer-main">
                    <text class="customer-name">{{item.name}}</text>
                    <text class="customer-meta">{{item.phone}}</text>
                    <text class="customer-note">{{item.note}}</text>
                </view>
                <view class="customer-status customer-status--{{item.tone}}">
                    {{item.status}}
                </view>
                <van-icon class="customer-arrow" name="arrow" size="22px" color="#8a8f98" />
            </view>
        </view>

        <view wx:if="{{!visibleList.length}}" class="customer-empty">
            没有找到符合条件的客户
        </view>
    </block>
</view>
