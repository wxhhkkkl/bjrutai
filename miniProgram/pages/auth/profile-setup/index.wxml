<flow-navigation title="完善资料" bind:back="handleBack" />

<view class="profile-setup-page">
  <text class="profile-setup-title">补充基础信息</text>
  <text class="profile-setup-description">用于完成账户识别与业务联系</text>

  <view class="profile-identity-card">
    <view class="profile-identity-card__avatar">
      <van-icon name="user-o" size="46px" color="#1677ff" />
    </view>
    <view class="profile-identity-card__copy">
      <text class="profile-identity-card__name">微信用户</text>
      <view class="profile-identity-card__phone">
        <text>{{session.phoneAuthorized || session.userId ? '手机号已授权' : '手机号未授权'}}</text>
        <van-icon name="passed" size="20px" color="#18a63d" />
      </view>
    </view>
  </view>

  <text class="profile-section-title">基本信息</text>
  <view class="profile-form-card">
    <view class="profile-field {{invalidField === 'name' ? 'profile-field--invalid' : ''}}">
      <text class="profile-field__label"><text class="profile-field__required">*</text>真实姓名</text>
      <input
        class="profile-field__input"
        value="{{form.name}}"
        data-field="name"
        bindinput="onFieldInput"
        maxlength="20"
        placeholder="请输入真实姓名"
        placeholder-class="profile-field__placeholder"
      />
      <van-icon name="edit" size="22px" color="#858c98" />
    </view>
    <view class="profile-field">
      <text class="profile-field__label">所属机构</text>
      <text class="profile-field__value">{{form.organization}}</text>
      <van-icon name="lock" size="22px" color="#858c98" />
    </view>
  </view>

</view>

<view class="profile-submit-bar">
  <button
    class="profile-submit-button tap-target"
    bindtap="submitProfile"
    hover-class="tap-feedback"
    hover-start-time="0"
    hover-stay-time="80"
    loading="{{saving}}"
    disabled="{{saving}}"
  >
    <van-icon wx:if="{{!saving}}" name="checked" size="29px" color="#ffffff" />
    <text>{{saving ? '正在提交' : '提交并继续'}}</text>
  </button>
  <text class="profile-submit-bar__hint">资料仅用于账户管理与业务协作</text>
  <view class="profile-submit-bar__safe"></view>
</view>
