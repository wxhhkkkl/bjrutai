.bind-page {
  min-height: 100vh;
  background: #ffffff;
  padding: 120rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bind-hero {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #f0faf2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.bind-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #111318;
}

.bind-description {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #606266;
  line-height: 1.6;
  text-align: center;
}

.bind-button {
  width: 100%;
  height: 96rpx;
  margin-top: 64rpx;
  border-radius: 25rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.bind-button[disabled] {
  opacity: 0.7;
}
