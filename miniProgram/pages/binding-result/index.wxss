page {
  background: #ffffff;
}

.result-page {
  min-height: 100vh;
  padding: 43rpx 36rpx calc(46rpx + constant(safe-area-inset-bottom));
  padding: 43rpx 36rpx calc(46rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 60%, #ffffff 100%);
}

.result-hero {
  min-height: 365rpx;
  margin-top: 34rpx;
  padding: 27rpx 34rpx 24rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  text-align: center;
  border-radius: 31rpx;
}

.result-hero--matching {
  background: linear-gradient(122deg, #eff7ff 0%, #f8fbff 48%, #eaf4ff 100%);
}

.result-hero--bound {
  min-height: 380rpx;
  background: linear-gradient(112deg, #fff0d9 0%, #f9fbff 49%, #e4f1ff 100%);
}

.result-hero--failed {
  min-height: 380rpx;
  background: linear-gradient(112deg, #fff0dc 0%, #fff8ef 50%, #ffefd8 100%);
}

.result-hero__image {
  display: block;
  flex: none;
}

.result-hero__image--matching {
  width: 124rpx;
  height: 124rpx;
}

.result-hero__image--bound,
.result-hero__image--failed {
  width: 158rpx;
  height: 158rpx;
}

.result-hero__title {
  margin-top: 22rpx;
  color: #050505;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.15;
}

.result-hero__status {
  min-height: 51rpx;
  margin-top: 18rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #1677ff;
  font-size: 25rpx;
  line-height: 1;
  background: #ffffff;
  border: 1rpx solid #1677ff;
  border-radius: 999rpx;
}

.result-hero__description {
  margin-top: 22rpx;
  color: #555c66;
  font-size: 25rpx;
  line-height: 1.45;
}

.result-hero--bound .result-hero__description,
.result-hero--failed .result-hero__description {
  margin-top: 24rpx;
  font-size: 27rpx;
}

.result-hero__meta {
  margin-top: 8rpx;
  color: #8a909a;
  font-size: 23rpx;
  line-height: 1.3;
}

.result-section-title {
  display: block;
  margin: 24rpx 7rpx 10rpx;
  color: #050505;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.result-card {
  background: #ffffff;
  border: 1rpx solid #edf0f4;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(28, 53, 88, 0.065);
}

.result-card-title {
  display: block;
  color: #050505;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.status-list-card {
  padding: 0 24rpx;
}

.status-row {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  gap: 29rpx;
  border-bottom: 1rpx solid #e4e8ee;
}

.status-row--last,
.explanation-row--last,
.reason-row--last {
  border-bottom: 0;
}

.result-tile {
  width: 59rpx;
  height: 59rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 15rpx;
}

.result-tile--blue-soft {
  background: linear-gradient(145deg, #e6f1ff, #f4f8ff);
}

.result-tile--green-soft {
  background: linear-gradient(145deg, #e5f8ec, #f1fbf5);
}

.result-tile--orange-soft {
  background: linear-gradient(145deg, #ffead8, #fff6ed);
}

.result-tile--yellow-soft {
  background: linear-gradient(145deg, #fff4d7, #fff9ea);
}

.status-row__label {
  min-width: 0;
  flex: 1;
  color: #24282e;
  font-size: 24rpx;
}

.status-row__value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 9rpx;
  color: #4f5660;
  font-size: 22rpx;
  white-space: nowrap;
}

.status-row__value--blue {
  color: #1677ff;
}

.status-row__value--green {
  color: #12a147;
}

.customer-info-card {
  padding: 16rpx 29rpx 14rpx;
}

.info-row {
  min-height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30rpx;
  color: #555c66;
  font-size: 22rpx;
}

.info-row__value {
  overflow: hidden;
  color: #24282e;
  text-align: right;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.customer-info-card__privacy {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #7c828c;
  font-size: 18rpx;
}

.result-timeline {
  padding: 0 28rpx;
}

.timeline-item {
  position: relative;
  min-height: 67rpx;
  display: flex;
  align-items: flex-start;
  gap: 27rpx;
}

.timeline-item::after {
  content: "";
  position: absolute;
  top: 42rpx;
  bottom: -4rpx;
  left: 23rpx;
  width: 2rpx;
  background: #b8d6ff;
}

.timeline-item--last::after {
  display: none;
}

.timeline-node {
  position: relative;
  z-index: 1;
  width: 47rpx;
  height: 47rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
}

.timeline-node--blue {
  background: #1677ff;
}

.timeline-node--green {
  background: #dcf5e6;
}

.timeline-copy {
  min-width: 0;
  padding-top: 2rpx;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.timeline-title {
  color: #15191e;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
}

.timeline-description {
  color: #747b85;
  font-size: 20rpx;
  line-height: 1.2;
}

.result-notice {
  min-height: 75rpx;
  margin-top: 18rpx;
  padding: 12rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: #4f5660;
  font-size: 22rpx;
  line-height: 1.4;
  border-radius: 24rpx;
}

.result-notice--blue {
  background: linear-gradient(90deg, #f2f8ff, #edf5ff);
}

.result-notice--outlined {
  min-height: 119rpx;
  margin-top: 30rpx;
  padding: 21rpx 35rpx;
  color: #22262c;
  font-size: 25rpx;
  background: linear-gradient(110deg, #f8fbff, #eef6ff);
  border: 1rpx solid #93c4ff;
  border-radius: 28rpx;
}

.result-notice__icon {
  width: 51rpx;
  height: 51rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 13rpx;
}

.result-notice__icon--blue,
.result-notice__square {
  background: linear-gradient(145deg, #3e94ff, #0969f2);
}

.result-notice__square {
  width: 81rpx;
  height: 81rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 17rpx;
}

.result-primary {
  height: 94rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 23rpx;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 600;
  line-height: 1;
  background: #050505;
  border-radius: 37rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.1);
}

.result-secondary {
  min-height: 65rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 25rpx;
  line-height: 1;
  border-radius: 17rpx;
}

.result-secondary--dark {
  color: #15191e;
  font-size: 27rpx;
}

.explanation-card {
  margin-top: 32rpx;
  padding: 35rpx 35rpx 12rpx;
}

.explanation-row {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #e4e8ee;
}

.explanation-row__label {
  width: 150rpx;
  flex: none;
  color: #24282e;
  font-size: 25rpx;
}

.explanation-row__value {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 13rpx;
  flex: 1;
  color: #515862;
  font-size: 23rpx;
  text-align: right;
  white-space: nowrap;
}

.explanation-row__value--orange {
  color: #ff6a00;
}

.continue-card {
  margin-top: 29rpx;
  padding: 35rpx 35rpx 16rpx;
}

.continue-row {
  min-height: 83rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  color: #15191e;
  font-size: 26rpx;
  border-radius: 16rpx;
}

.continue-row > text {
  min-width: 0;
  flex: 1;
}

.continue-row__icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 15rpx;
}

.continue-row__icon--blue {
  background: linear-gradient(145deg, #4c9cff, #1677ff);
}

.continue-row__icon--green {
  background: linear-gradient(145deg, #64d17e, #2bb654);
}

.reasons-card {
  margin-top: 29rpx;
  padding: 37rpx 36rpx 15rpx;
}

.reason-row {
  min-height: 86rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  color: #1f242a;
  font-size: 25rpx;
  border-bottom: 1rpx solid #e4e8ee;
}

.result-advice {
  min-height: 163rpx;
  margin-top: 25rpx;
  padding: 31rpx 34rpx;
  display: flex;
  align-items: flex-start;
  gap: 39rpx;
  background: linear-gradient(112deg, #f8fbff 0%, #eef6ff 100%);
  border: 1rpx solid #97c6ff;
  border-radius: 28rpx;
}

.result-advice__icon,
.result-help__icon {
  width: 98rpx;
  height: 98rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: linear-gradient(145deg, #4d9eff, #096cf5);
  border-radius: 20rpx;
}

.result-advice__copy,
.result-help__copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.result-advice__title,
.result-help__title {
  color: #15191e;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.2;
}

.result-advice__description,
.result-help__description {
  margin-top: 13rpx;
  color: #626974;
  font-size: 22rpx;
  line-height: 1.6;
}

.result-help {
  min-height: 134rpx;
  margin-top: 25rpx;
  padding: 20rpx 35rpx;
  display: flex;
  align-items: center;
  gap: 39rpx;
  background: #ffffff;
  border: 1rpx solid #edf0f4;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(28, 53, 88, 0.065);
}

.result-help__description {
  margin-top: 10rpx;
  line-height: 1.3;
}

@media (max-width: 350px) {
  .result-page {
    padding-right: 27rpx;
    padding-left: 27rpx;
  }

  .result-hero__title {
    font-size: 39rpx;
  }

  .explanation-row {
    gap: 13rpx;
  }

  .explanation-row__label {
    width: 126rpx;
  }

  .explanation-row__value {
    font-size: 21rpx;
  }
}
