@import "../../styles/interactions.wxss";

.flow-navigation {
  position: relative;
  z-index: 20;
  width: 100%;
  background: rgba(255, 255, 255, 0.98);
}

.flow-navigation__row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flow-navigation__back {
  position: absolute;
  left: calc(75rpx - 22px);
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flow-navigation__back.tap-feedback {
  background-color: transparent;
}

.flow-navigation__title {
  max-width: 430rpx;
  overflow: hidden;
  color: #050505;
  font-size: 39rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  text-overflow: ellipsis;
}
