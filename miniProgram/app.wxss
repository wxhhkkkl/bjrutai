@import "./styles/interactions.wxss";

page {
  --blue: #1677ff;
  --blue-soft: #eaf4ff;
  --ink: #101828;
  --muted: #7d8799;
  --line: #e8edf5;
  --surface: #ffffff;
  --radius-lg: 36rpx;
  --radius-md: 24rpx;
  --shadow: 0 12rpx 32rpx rgba(34, 78, 145, 0.08);
  background: #f8fbff;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input { box-sizing: border-box; }
button::after { border: 0; }

.screen { min-height: 100vh; padding: 32rpx 28rpx 148rpx; }
.tab-screen {
  padding-bottom: calc(156rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
}
.section-title { display: block; font-size: 40rpx; font-weight: 700; margin: 42rpx 0 22rpx; }
.card { background: var(--surface); border: 1rpx solid #eef2f7; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
.muted { color: var(--muted); }
.primary-button { min-height: 88rpx; padding: 0 34rpx; display: inline-flex; align-items: center; justify-content: center; gap: 14rpx; color: #fff; background: #050505; border-radius: 999rpx; font-size: 30rpx; font-weight: 600; }
.link-button { color: var(--blue); font-size: 28rpx; background: transparent; padding: 0; }
.safe-top { padding-top: calc(20rpx + env(safe-area-inset-top)); }
