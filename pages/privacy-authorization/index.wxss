page {
  background: #ffffff;
}

.privacy-page {
  min-height: 100vh;
  padding: 38rpx 46rpx calc(202rpx + constant(safe-area-inset-bottom));
  padding: 38rpx 46rpx calc(202rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 70%, #f8fbff 100%);
}

.privacy-title {
  display: block;
  color: #050505;
  font-size: 43rpx;
  font-weight: 700;
  line-height: 1;
}

.privacy-description {
  display: block;
  margin-top: 22rpx;
  color: #69717d;
  font-size: 24rpx;
  line-height: 1;
}

.privacy-hero {
  min-height: 174rpx;
  margin-top: 35rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(105deg, #f2f8ff 0%, #ffffff 53%, #edf6ff 100%);
  border: 1rpx solid #9bc7ff;
  border-radius: 22rpx;
}

.privacy-hero__icon {
  position: relative;
  width: 190rpx;
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.privacy-hero__icon::before {
  position: absolute;
  right: 7rpx;
  left: 7rpx;
  bottom: 20rpx;
  height: 49rpx;
  content: "";
  border: 2rpx solid #71adff;
  border-radius: 50%;
}

.privacy-hero__lock {
  position: absolute;
  top: 46rpx;
  left: 84rpx;
  width: 42rpx;
  height: 47rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1677ff;
  border-radius: 10rpx;
}

.privacy-hero__copy {
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.privacy-hero__title {
  color: #101419;
  font-size: 28rpx;
  font-weight: 700;
}

.privacy-hero__description {
  margin-top: 17rpx;
  color: #68717d;
  font-size: 20rpx;
  line-height: 1.4;
}

.privacy-hero__badge {
  width: fit-content;
  min-height: 38rpx;
  margin-top: 16rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: #0a9e30;
  font-size: 19rpx;
  border: 2rpx solid currentColor;
  border-radius: 999rpx;
}

.privacy-section-title {
  display: block;
  margin-top: 34rpx;
  color: #050505;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.privacy-authorization-card,
.privacy-settings-card,
.privacy-document-card {
  margin-top: 20rpx;
  padding: 0 27rpx;
  background: #ffffff;
  border: 1rpx solid #e7ebf1;
  border-radius: 24rpx;
  box-shadow: 0 9rpx 25rpx rgba(31, 61, 105, 0.06);
}

.privacy-authorization-row {
  min-height: 77rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  border-bottom: 1rpx solid #e2e6ec;
  border-radius: 6rpx;
}

.privacy-authorization-row:last-child {
  border-bottom: 0;
}

.privacy-authorization-row__icon {
  width: 46rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.privacy-authorization-row__title {
  color: #101419;
  font-size: 23rpx;
  font-weight: 500;
}

.privacy-authorization-row__copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.privacy-authorization-row__copy .privacy-authorization-row__title {
  line-height: 1;
}

.privacy-authorization-row__description {
  color: #78818d;
  font-size: 18rpx;
  line-height: 1;
}

.privacy-authorization-row__phone {
  margin-left: auto;
  color: #101419;
  font-size: 22rpx;
  font-weight: 500;
}

.privacy-authorization-row__status {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  white-space: nowrap;
}

.privacy-authorization-row__status--green {
  color: #0a9e30;
}

.privacy-authorization-row__status--blue {
  color: #1677ff;
}

.privacy-authorization-row__status--orange {
  color: #ef6600;
}

.privacy-section-title--settings {
  margin-top: 31rpx;
}

.privacy-setting-row {
  min-height: 85rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #e2e6ec;
}

.privacy-setting-row:last-child {
  border-bottom: 0;
}

.privacy-setting-row__icon {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.privacy-setting-row__user {
  position: absolute;
  right: 4rpx;
  bottom: 5rpx;
  padding: 2rpx;
  background: #ffffff;
  border-radius: 50%;
}

.privacy-setting-row__copy {
  min-width: 0;
  margin-left: 15rpx;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
}

.privacy-setting-row__title {
  color: #101419;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1;
}

.privacy-setting-row__description {
  color: #78818d;
  font-size: 18rpx;
  line-height: 1;
}

.privacy-switch {
  flex: none;
  transform: scale(0.82);
  transform-origin: right center;
}

.privacy-section-title--documents {
  margin-top: 29rpx;
}

.privacy-document-row {
  min-height: 59rpx;
  display: flex;
  align-items: center;
  gap: 17rpx;
  border-bottom: 1rpx solid #e2e6ec;
  border-radius: 6rpx;
}

.privacy-document-row:last-child {
  border-bottom: 0;
}

.privacy-document-row__icon {
  width: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.privacy-document-row__title {
  min-width: 0;
  flex: 1;
  color: #101419;
  font-size: 22rpx;
}

.privacy-revoke {
  min-height: 56rpx;
  margin-top: 19rpx;
  padding: 10rpx 25rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: #1677ff;
  font-size: 20rpx;
  background: #eff6ff;
  border: 1rpx solid #b7d6ff;
  border-radius: 15rpx;
}

.privacy-revoke__icon {
  width: 31rpx;
  height: 31rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: #1677ff;
  border-radius: 8rpx;
}

.privacy-save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  padding: 20rpx 46rpx calc(22rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 46rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #edf0f4;
}

.privacy-save-button {
  width: 100%;
  height: 89rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  background: #050505;
  border-radius: 999rpx;
}

.privacy-save-button--disabled {
  opacity: 0.72;
}

.privacy-save-button > text {
  display: block;
  line-height: 1;
  white-space: nowrap;
}

.privacy-save-bar__hint {
  display: block;
  margin-top: 20rpx;
  color: #8c939e;
  font-size: 20rpx;
  line-height: 1;
  text-align: center;
}

@media (max-width: 350px) {
  .privacy-page {
    padding-right: 35rpx;
    padding-left: 35rpx;
  }

  .privacy-hero {
    padding-right: 21rpx;
    padding-left: 21rpx;
  }

  .privacy-hero__icon {
    width: 155rpx;
  }

  .privacy-hero__copy {
    margin-left: 10rpx;
  }

  .privacy-authorization-card,
  .privacy-settings-card,
  .privacy-document-card {
    padding-right: 21rpx;
    padding-left: 21rpx;
  }
}
