page {
  background: #ffffff;
}

.qualification-page {
  min-height: 100vh;
  padding: 26rpx 30rpx calc(155rpx + constant(safe-area-inset-bottom));
  padding: 26rpx 30rpx calc(155rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 64%, #ffffff 100%);
}

.qualification-hero {
  position: relative;
  height: 351rpx;
  margin-right: -6rpx;
  margin-left: -6rpx;
  overflow: hidden;
  border-radius: 31rpx;
}

.qualification-hero__banner {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  width: 100%;
  height: 351rpx;
}

.qualification-hero__title {
  position: absolute;
  top: 116rpx;
  left: 186rpx;
  z-index: 3;
  max-width: 325rpx;
  color: #050505;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.qualification-hero__description {
  position: absolute;
  top: 217rpx;
  left: 37rpx;
  z-index: 3;
  max-width: 440rpx;
  color: #565d67;
  font-size: 25rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.qualification-hero__badge {
  position: absolute;
  top: 272rpx;
  left: 37rpx;
  z-index: 3;
  height: 42rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  color: #0b9c30;
  font-size: 22rpx;
  line-height: 1;
  border: 2rpx solid #0b9c30;
  border-radius: 999rpx;
}

.qualification-page--blue .qualification-hero__badge {
  color: #1677ff;
  border-color: #1677ff;
}

.qualification-page--red .qualification-hero__badge {
  color: #ef321b;
  border-color: #ef321b;
}

.qualification-page--orange .qualification-hero__badge {
  color: #ef6c00;
  border-color: #ef6c00;
}

.qualification-section-title,
.qualification-subsection-title {
  display: block;
  color: #050505;
  font-weight: 700;
  line-height: 1;
}

.qualification-section-title {
  margin: 45rpx 16rpx 21rpx;
  font-size: 35rpx;
}

.qualification-subsection-title {
  margin: 35rpx 16rpx 19rpx;
  font-size: 31rpx;
}

.qualification-information {
  padding: 0 30rpx;
  background: #ffffff;
  border: 1rpx solid #e7ebf1;
  border-radius: 29rpx;
  box-shadow: 0 8rpx 22rpx rgba(30, 55, 91, 0.05);
}

.qualification-information__row {
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  border-bottom: 1rpx solid #e4e8ee;
}

.qualification-information__row:last-child {
  border-bottom: 0;
}

.qualification-information__label {
  flex: none;
  color: #555c67;
  font-size: 25rpx;
}

.qualification-information__value {
  overflow: hidden;
  color: #111723;
  font-size: 26rpx;
  font-weight: 500;
  text-align: right;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.qualification-information__value--warning {
  color: #ef6c00;
}

.qualification-file {
  min-height: 139rpx;
  margin-top: 22rpx;
  padding: 20rpx 31rpx;
  display: flex;
  align-items: center;
  gap: 25rpx;
  background: #ffffff;
  border: 1rpx solid #e7ebf1;
  border-radius: 27rpx;
  box-shadow: 0 8rpx 22rpx rgba(30, 55, 91, 0.05);
}

.qualification-file__icon {
  position: relative;
  width: 87rpx;
  height: 91rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: #eff6ff;
  border: 1rpx solid #bfd9ff;
  border-radius: 15rpx;
}

.qualification-file__icon text {
  position: absolute;
  bottom: 13rpx;
  color: #1677ff;
  font-size: 17rpx;
  font-weight: 700;
}

.qualification-file__copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
}

.qualification-file__name {
  overflow: hidden;
  color: #080b10;
  font-size: 27rpx;
  font-weight: 500;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.qualification-file__meta {
  color: #69717d;
  font-size: 23rpx;
}

.qualification-file__action {
  color: #1677ff;
  font-size: 25rpx;
}

.qualification-reason {
  min-height: 104rpx;
  padding: 18rpx 25rpx;
  display: flex;
  align-items: flex-start;
  gap: 21rpx;
  color: #262a31;
  font-size: 23rpx;
  line-height: 1.55;
  background: #fff7f4;
  border: 1rpx solid #ffb8a9;
  border-radius: 16rpx;
}

.qualification-reason > van-icon {
  margin-top: 3rpx;
  flex: none;
}

.qualification-record {
  min-height: 120rpx;
  padding: 24rpx 31rpx;
  display: flex;
  background: #ffffff;
  border: 1rpx solid #e7ebf1;
  border-radius: 25rpx;
  box-shadow: 0 8rpx 22rpx rgba(30, 55, 91, 0.05);
}

.qualification-record__timeline {
  position: relative;
  width: 32rpx;
  flex: none;
}

.qualification-record__dot {
  position: absolute;
  top: 5rpx;
  left: 0;
  z-index: 2;
  width: 23rpx;
  height: 23rpx;
  background: #0baa36;
  border: 5rpx solid #e3f7e8;
  border-radius: 50%;
}

.qualification-page--blue .qualification-record__dot {
  background: #1677ff;
  border-color: #deedff;
}

.qualification-page--red .qualification-record__dot {
  background: #f03b20;
  border-color: #ffe2db;
}

.qualification-record__line {
  position: absolute;
  top: 28rpx;
  left: 10rpx;
  width: 2rpx;
  height: 48rpx;
  background: #d8dde5;
}

.qualification-record__copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 16rpx;
}

.qualification-record__heading {
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: #080b10;
  font-size: 26rpx;
  font-weight: 600;
}

.qualification-record__description {
  color: #666e79;
  font-size: 22rpx;
}

.qualification-notice {
  min-height: 80rpx;
  margin-top: 27rpx;
  padding: 14rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #26313e;
  font-size: 22rpx;
  background: #f2f7ff;
  border: 1rpx solid #c9dfff;
  border-radius: 17rpx;
}

.qualification-page--orange .qualification-notice {
  background: #fff8ee;
  border-color: #ffd39e;
}

.qualification-notice__icon {
  width: 63rpx;
  height: 63rpx;
  margin-right: 21rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: #e8f2ff;
  border: 1rpx solid #bed7ff;
  border-radius: 13rpx;
}

.qualification-page--orange .qualification-notice__icon {
  background: #fff0dc;
  border-color: #ffd19a;
}

.qualification-notice__highlight {
  margin: 0 8rpx;
  color: #1677ff;
  font-size: 30rpx;
  font-weight: 600;
}

.qualification-page--orange .qualification-notice__highlight {
  color: #ef6c00;
}

.qualification-action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  padding: 15rpx 42rpx calc(14rpx + constant(safe-area-inset-bottom));
  padding: 15rpx 42rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #edf0f4;
}

.qualification-primary-action {
  width: 100%;
  height: 89rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  gap: 23rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  background: #050505;
  border-radius: 999rpx;
}

.qualification-primary-action > text {
  display: block;
  line-height: 1;
  white-space: nowrap;
}

@media (max-width: 350px) {
  .qualification-page {
    padding-right: 25rpx;
    padding-left: 25rpx;
  }

  .qualification-hero__title {
    left: 186rpx;
    font-size: 33rpx;
  }

  .qualification-hero__description {
    left: 28rpx;
    font-size: 22rpx;
  }

  .qualification-information__value {
    font-size: 23rpx;
  }

  .qualification-notice {
    padding-right: 18rpx;
    padding-left: 18rpx;
    font-size: 20rpx;
  }
}
