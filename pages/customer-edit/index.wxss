page {
  background: #ffffff;
}

.edit-page {
  min-height: 100vh;
  padding: 26rpx 38rpx calc(150rpx + constant(safe-area-inset-bottom));
  padding: 26rpx 38rpx calc(150rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 64%, #ffffff 100%);
}

.edit-customer-summary {
  min-height: 169rpx;
  padding: 23rpx 25rpx;
  display: flex;
  align-items: center;
  gap: 44rpx;
  background: linear-gradient(112deg, #f7fbff, #ffffff);
  border: 1rpx solid #bddbff;
  border-radius: 26rpx;
}

.edit-customer-summary__avatar {
  width: 111rpx;
  height: 111rpx;
  flex: none;
  border: 1rpx solid #cfe4ff;
  border-radius: 20rpx;
}

.edit-customer-summary__copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.edit-customer-summary__name {
  color: #050505;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.1;
}

.edit-customer-summary__phone {
  margin-top: 11rpx;
  color: #555c66;
  font-size: 23rpx;
  line-height: 1.1;
}

.edit-customer-summary__hint {
  margin-top: 15rpx;
  color: #555c66;
  font-size: 21rpx;
  line-height: 1.25;
}

.edit-customer-summary__status {
  min-width: 119rpx;
  height: 44rpx;
  padding: 0 13rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  flex: none;
  align-self: flex-start;
  margin-top: 13rpx;
  color: #1677ff;
  font-size: 22rpx;
  background: #ffffff;
  border: 1rpx solid #1677ff;
  border-radius: 15rpx;
}

.edit-section-title {
  display: block;
  margin: 33rpx 5rpx 17rpx;
  color: #050505;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.edit-card {
  background: #ffffff;
  border: 1rpx solid #e4e8ee;
  border-radius: 27rpx;
  box-shadow: 0 9rpx 23rpx rgba(28, 53, 88, 0.055);
}

.basic-info-card {
  padding: 0 24rpx;
}

.edit-field {
  min-height: 85rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-bottom: 1rpx solid #e4e8ee;
}

.edit-field--last {
  border-bottom: 0;
}

.edit-field__icon {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: linear-gradient(145deg, #e9f4ff, #f5f9ff);
  border-radius: 14rpx;
}

.edit-field__label {
  width: 166rpx;
  display: flex;
  gap: 8rpx;
  flex: none;
  color: #161a20;
  font-size: 25rpx;
  white-space: nowrap;
}

.edit-field__required {
  color: #ef2727;
}

.edit-field__value {
  min-width: 0;
  overflow: hidden;
  flex: 1;
  color: #59616d;
  font-size: 23rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.edit-field__action {
  min-width: 54rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #1677ff;
  font-size: 23rpx;
  border-radius: 13rpx;
}

.edit-field__action--icon {
  min-width: 46rpx;
}

.edit-note {
  position: relative;
  height: 193rpx;
  padding: 21rpx 27rpx 45rpx;
  background: #ffffff;
  border: 1rpx solid #cfd5de;
  border-radius: 24rpx;
}

.edit-note__label {
  display: block;
  color: #30353c;
  font-size: 24rpx;
  line-height: 1.2;
}

.edit-note__input {
  width: 100%;
  height: 104rpx;
  margin-top: 11rpx;
  color: #262b32;
  font-size: 24rpx;
  line-height: 1.5;
}

.edit-note__placeholder {
  color: #8a909a;
}

.edit-note__count {
  position: absolute;
  right: 24rpx;
  bottom: 17rpx;
  color: #737a85;
  font-size: 21rpx;
}

.attribution-card {
  padding: 0 25rpx;
}

.attribution-row {
  min-height: 71rpx;
  display: flex;
  align-items: center;
  gap: 26rpx;
  color: #20242a;
  font-size: 23rpx;
  border-bottom: 1rpx solid #e4e8ee;
}

.attribution-row--last {
  border-bottom: 0;
}

.attribution-row__icon {
  width: 49rpx;
  height: 49rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 12rpx;
}

.attribution-row__icon--blue {
  background: linear-gradient(145deg, #e8f3ff, #f5f9ff);
}

.attribution-row__icon--green {
  background: linear-gradient(145deg, #e5f8ec, #f3fbf6);
}

.attribution-row__status {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.attribution-row__status--blue {
  color: #1677ff;
}

.attribution-row__status--green {
  color: #12a147;
}

.attribution-row__owner {
  margin-left: auto;
  color: #606873;
}

.edit-notice {
  min-height: 54rpx;
  margin-top: 15rpx;
  padding: 10rpx 23rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 20rpx;
  line-height: 1.35;
  border-radius: 17rpx;
}

.edit-notice--warning {
  color: #363b43;
  background: #fff8f1;
  border: 1rpx solid #ffc68f;
}

.edit-notice--authorization {
  margin-top: 11rpx;
  color: #1677ff;
  background: #f1f7ff;
  border: 1rpx solid #9dc9ff;
}

.edit-action-bar {
  position: fixed;
  z-index: 30;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 127rpx;
  padding: 18rpx 39rpx calc(18rpx + constant(safe-area-inset-bottom));
  padding: 18rpx 39rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e3e7ed;
}

.edit-action {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 17rpx;
  flex: 1;
  font-size: 28rpx;
  line-height: 1;
  border-radius: 999rpx;
}

.edit-action--cancel {
  color: #1677ff;
  background: #ffffff;
  border: 2rpx solid #1677ff;
}

.edit-action--save {
  color: #ffffff;
  background: #050505;
  box-shadow: 0 9rpx 18rpx rgba(0, 0, 0, 0.1);
}

.field-editor-mask {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 0 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.38);
}

.field-editor {
  width: 100%;
  padding: 35rpx 32rpx 29rpx;
  background: #ffffff;
  border-radius: 27rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.16);
}

.field-editor__title {
  display: block;
  color: #050505;
  font-size: 32rpx;
  font-weight: 700;
}

.field-editor__hint {
  display: block;
  margin-top: 13rpx;
  color: #ff6a00;
  font-size: 21rpx;
}

.field-editor__input {
  height: 78rpx;
  margin-top: 26rpx;
  padding: 0 21rpx;
  color: #232830;
  font-size: 26rpx;
  background: #f8fbff;
  border: 1rpx solid #bcd9ff;
  border-radius: 17rpx;
}

.field-editor__actions {
  margin-top: 27rpx;
  display: flex;
  gap: 19rpx;
}

.field-editor__button {
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  font-size: 25rpx;
  border-radius: 999rpx;
}

.field-editor__button--cancel {
  color: #1677ff;
  border: 1rpx solid #1677ff;
}

.field-editor__button--confirm {
  color: #ffffff;
  background: #1677ff;
}

@media (max-width: 350px) {
  .edit-page {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .edit-customer-summary {
    gap: 25rpx;
  }

  .edit-field {
    gap: 14rpx;
  }

  .edit-field__label {
    width: 138rpx;
  }

  .edit-action-bar {
    gap: 19rpx;
    padding-right: 27rpx;
    padding-left: 27rpx;
  }
}
